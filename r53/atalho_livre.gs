  var antes=x.t?Math.max(0,Number(q(3))||0):0,fim=r53LivrePasso_(q(1),q(2),antes,passo);
  gravou=true;ficha.getRange(x.a).setValue(fim.atual);
  if(x.t&&fim.temp!==antes)ficha.getRange(x.t).setValue(fim.temp);
