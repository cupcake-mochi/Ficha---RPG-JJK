var VALORES_DAS_ORIGENS_ = [
  {
    "nome":"DADOS",
    "vals":[
      [4,122,"capacidade da origem",6],[4,123,"origem da capacidade",6],[4,124,"tipo da capacidade",6],[4,125,"exige",6],[4,126,"frequência da capacidade",6],[4,127,"texto da capacidade",6],[5,122,"Tentativa e Erro",5],[5,123,"Latente",5],[5,124,"marcante",5],[5,125,"",5],[5,126,"Uma vez entre um turno seu e o próximo",5],
      [5,127,"Você arrisca a dosagem de energia para executar um feitiço ou Manejo de Classe 1 ou maior. Uma vez entre o começo de um turno seu e o começo do próximo, antes de pagar a aplicação, pode usar Tentativa e Erro, sem outra ação. Se não tentar, paga o custo normal.\n\nCalcule o custo normal completo, com descontos e acréscimos. A variação é metade da Classe utilizada, arredondada para cima. Você só pode tentar se tiver PE suficientes para pagar o pior resultado possível: o custo completo mais essa variação, respeitado o mínimo de 1 PE. Depois, role 1d20 + Maestria.\n\nTotal | Custo\n9 ou menos | Desperdício: acrescente a variação.\n10 a 13 | Estável: conserve o custo completo.\n14 ou mais | Controle: desconte a variação.\n\nO custo final mínimo é 1 PE. Classes 1 e 2 variam 1 PE; 3 e 4, 2 PE; 5 e 6, 3 PE; Classe 7, 4 PE. Pague apenas o resultado obtido. Dano, acerto, CD, alcance, duração e efeitos permanecem iguais.\n\nEsta é uma rolagem própria da capacidade, não um teste. Não recebe vantagem, desvantagem, especialização ou modificadores de testes, salvo regra específica para ela. Também não usa crítico ou sucesso e falha automáticos de outros procedimentos.\n\nExemplo: um feitiço de Classe 3 custa 6 PE depois dos ajustes. A variação é 2: você precisa ter 8 PE para tentar. Desperdício custa 8, Estável custa 6 e Controle custa 4. Já um feitiço de Classe 1 com custo completo de 1 PE custa 2, 1 ou 1 PE; o desconto nunca o torna gratuito.",5],
      [6,122,"Coexistência",5],[6,123,"Receptáculo",5],[6,124,"marcante",5],[6,125,"",5],[6,126,"Uma vez por cena",5],
      [6,127,"A presença aceita conscientemente você à frente do corpo. As identidades permanecem distintas e ainda podem discordar. Sua marcante reúne Repertório Compartilhado e Amparo Interior.\n\nRepertório Compartilhado.\n\nAo receber a marcante, aprenda dois feitiços adicionais, fora dos espaços comuns de repertório. Se for Sem Técnica, receba dois Manejos em seu lugar. Eles seguem a Regra, as Famílias, os requisitos e o limite de Classe da sua rota, com ações e custos normais.\n\nO ganho acontece uma vez. As aplicações permanecem conhecidas e seguem as revisões normais da ficha. Não são espaços livres para Talentos, Domínio ou invocações, não concedem outra Regra e não aumentam a quantidade de Classe 0.\n\nAmparo Interior.\n\nUma vez por cena, no começo do seu turno, se estiver Atordoado, pode gastar 6 PE para encerrar essa condição em você, sem ação ou teste, antes de perder a Padrão daquele turno. Precisa ter vida e Integridade positivas e PE suficientes.\n\nAmparo não encerra Inconsciente, não recupera reservas nem devolve ações gastas ou perdidas em turnos anteriores. Uma Concentração já interrompida continua encerrada.",5],
      [7,122,"Conflito",5],[7,123,"Receptáculo",5],[7,124,"marcante",5],[7,125,"",5],[7,126,"Uma vez por dia · Uma vez entre um turno seu e o próximo",5],
      [
        7,127,
        "A presença pretende tomar o corpo, e você a mantém contida. Sua marcante reúne a defesa da alma, Reserva Impregnada e Resposta à Invasão.\n\nVocê tem vantagem nos TRs que um efeito permitir para evitar dano de Alma. Isso não cria um teste contra ataques que não o concedam, não amplia o benefício a todo efeito mental ou manipulação da alma e não muda a redução desse dano.\n\nReserva Impregnada.\n\nUma vez por dia, use uma Ação Bônus para recuperar PE iguais à metade do seu nível + metade de Essência ou Constituição, escolhida no uso. Arredonde cada metade para baixo, mínimo 1 em cada parcela, sem ultrapassar seus PE máximos.\n\nÉ recuperação da reserva comum, sem custo de PE ou exigência de vida baixa. Não concede energia temporária.\n\nResposta à Invasão.\n\nUma vez entre o começo de um turno seu e o começo do próximo, depois de uma criatura tentar causar dano de Alma ou manipular diretamente sua alma de forma hostil, você pode fazê-la enfrentar a presença que guarda. Resolva a tentativa original normalmente, mesmo que você evite o efeito. Depois, o agressor faz TR de Espírito com desvantagem, CD 8 + sua Maestria + Constituição ou Essência, escolhida no uso.\n\nNa falha, ele fica Amedrontado por você até o fim do próximo turno dele, com o TR normal de saída no fim de cada turno. No sucesso, seja no TR inicial ou numa saída, fica imune à resposta deste Receptáculo até o fim do próximo turno dele. Mantenha a CD da aplicação nas saídas; a desvantagem especial vale para o teste inicial, sem afastar outras fontes que alterem os testes posteriores.\n\nA resposta não gasta ação, Reação ou PE. O limite é total, não um uso por agressor, e é consumido ao exigir o teste inicial. A tentativa original não é desfeita. Dano Psíquico comum, contato físico comum e cura consentida não satisfazem o gatilho por si sós.\n\nSe o efeito começar durante o turno do agressor, “próximo turno” é o seguinte, não o atual. Fora do turno dele, é o primeiro que vier depois. A duração terminar sem sucesso num TR não concede a imunidade; a imunidade recebida não vale contra outras fontes de medo.",
        5
      ],
      [8,122,"Zenin",5],[8,123,"Descendente",5],[8,124,"marcante",5],[8,125,"",5],[8,126,"Uma vez por dia · Maestria vezes por dia",5],
      [8,127,"Sua formação prepara postura, movimentos e resistência para enfrentar a pressão de uma luta. Kukuru é a formação Sem Técnica; Akashi integra esse preparo ao uso de uma técnica. Ambas concedem os três componentes abaixo; Disciplina Treinada muda o TR conforme a formação.\n\nRecuperação do Fôlego.\n\nUma vez por dia, ao concluir um descanso curto válido, pode remover um degrau de Exaustão. Calcule a recuperação normal da pausa antes dessa remoção. A contagem de lutas do dia permanece, assim como as exigências de descanso e ambiente.\n\nNão guarda retiradas futuras, reduz Exaustão abaixo de zero ou recupera Integridade e condições de outras fontes.\n\nExecução Treinada.\n\nMaestria vezes por dia, antes de um teste de Atletismo ou Acrobacia, pode fazê-lo com vantagem, sem ação ou PE adicionais. As duas perícias compartilham os usos. Mantenha modificadores e requisitos; não concede treino nem afeta ataques ou TRs.\n\nDisciplina Treinada.\n\nUma vez por dia, quando falhar no TR da sua formação, pode repeti-lo antes das consequências e deve aceitar o segundo resultado: Vigor para Kukuru; Espírito para Akashi.\n\nNão exige ação ou PE adicionais. Mantenha modificadores, vantagem e desvantagem aplicáveis. O uso é gasto mesmo na nova falha. Não concede treino, troca o atributo do TR ou permite substituir o teste pedido. Uma interrupção direta sem teste continua acontecendo.\n\nOs três componentes têm estoques independentes. Descanso curto não renova usos por dia.",5],
      [9,122,"Kamo",5],[9,123,"Descendente",5],[9,124,"marcante",5],[9,125,"",5],[9,126,"Maestria vezes por dia",5],
      [
        9,127,
        "Você aprendeu a ensaiar procedimentos e corrigir a execução quando algo sai errado. Sua marcante reúne Execução Ensaiada e Contingência Estudada. A formação não concede Manipulação de Sangue.\n\nExecução Ensaiada.\n\nAo concluir um descanso longo, escolha duas opções distintas entre perícias, Ofícios e TRs em que seja treinado. Depois role 3d20 e anote os dois maiores resultados. Essa reserva permanece até concluir o próximo descanso longo.\n\nAntes de rolar um teste de uma das opções, pode gastar um resultado anotado para substituir um dos d20 por aquele valor, somando os modificadores normais. No máximo um resultado por teste; cada um só pode ser usado uma vez. Os dois resultados são compartilhados entre as duas competências.\n\nCom vantagem ou desvantagem, role o outro d20 e escolha normalmente o maior ou menor. Se ambas se anularem, substitua o único d20. Declare antes de rolar qualquer dado do teste, sem ação ou PE adicionais. Pode gastar os dois resultados em testes diferentes da mesma competência.\n\nAs opções precisam estar treinadas no preparo e no uso. Escolha TRs pelo nome, como Vigor, não por atributo. Ataques, dano e testes de outra criatura ficam fora. A tarefa conserva ferramentas, materiais, ações e demais requisitos; um resultado reservado não garante sucesso.\n\nOs 3d20 do preparo são uma rolagem própria, sem modificadores, vantagem ou repetições de testes. Não produzem crítico ou sucesso ao serem anotados. No próximo descanso longo, resultados não usados expiram e o novo ensaio substitui escolhas e reserva. Descanso curto não renova os dados. Se outra regra permitir repetir o teste posteriormente, o valor reservado já foi consumido e a nova tentativa usa os dados normais.\n\nExemplo: você escolhe Acrobacia e Vigor, ambos treinados. Rola 5, 12 e 17, guardando 12 e 17. Antes de um teste de Acrobacia, usa o 17 e soma seus bônus. O 12 continua disponível. Com desvantagem, ainda rolaria o outro d20 e ficaria com o menor.\n\nContingência Estudada.\n\nMaestria vezes por dia, quando errar uma rolagem de acerto que você faça, inclusive a de um feitiço de Acerto, pode repeti-la antes das consequências. Aceite o segundo resultado. Não exige outra ação ou PE e pode ser usada uma vez por tentativa.\n\nRepita o procedimento completo, com os modificadores e vantagem ou desvantagem aplicáveis, sem misturar dados das duas rolagens. Conserve alvo, capacidade, custos pagos e defesa já resolvida. Não repita os outros ataques ou alvos da aplicação.\n\nNão rerrola dano, faz o alvo repetir TR ou modifica feitiço Automático. Não devolve PE nem permite trocar de feitiço. Os usos são independentes dos resultados de Execução Ensaiada e renovam por dia, não por descanso longo.",
        5
      ],
      [10,122,"Gojo",5],[10,123,"Descendente",5],[10,124,"marcante",5],[10,125,"",5],[10,126,"Maestria vezes por dia",5],
      [
        10,127,
        "O estudo da sua técnica inclui execuções reservadas e respostas a capacidades que já conhece. Sua marcante reúne Execução Reservada e Antecipação Estudada. Ela não concede Seis Olhos ou Ilimitado.\n\nExecução Reservada.\n\nEscolha feitiços ou Manejos conhecidos em quantidade total igual à Maestria e registre a lista. Maestria vezes por dia, ao usar uma dessas capacidades, antes dos dados, escolha um benefício:\n\n- Vantagem em uma rolagem de acerto da aplicação.\n\n- Desvantagem no primeiro TR de um único alvo contra a aplicação.\n\nIndique a rolagem ou o alvo antes dos dados. Cada aplicação recebe no máximo um uso, escolhendo apenas um benefício. Não custa ação ou PE adicionais; a capacidade conserva seus custos e requisitos. O uso é gasto ao declarar, mesmo sem resultado favorável.\n\nOs usos formam um estoque compartilhado entre as capacidades. A lista é fixa: se conhecer menos opções que sua Maestria, preencha as vagas restantes quando aprender uma elegível; quando Maestria aumentar, acrescente uma opção conhecida. Se a progressão permitir substituir uma capacidade registrada, a vaga pode acompanhar sua substituta, sem conceder troca extra.\n\nUma área não impõe desvantagem a todos os alvos. TRs posteriores e os outros ataques da aplicação conservam suas rolagens. Automáticos sem acerto ou TR não oferecem rolagem elegível, e ataques comuns não se tornam elegíveis pela sua Origem. Bloquear continua disponível normalmente, sem desvantagem concedida por esta capacidade.\n\nAntecipação Estudada.\n\nMaestria vezes por dia, depois de falhar em um TR contra feitiço ou Manejo e antes das consequências, pode gastar sua Reação para repetir esse teste, se a capacidade cumprir pelo menos uma condição:\n\n- Pertencer a uma técnica que você tenha estudado; para Manejos, vale o estudo da própria capacidade.\n\n- Você já ter presenciado uma aplicação anterior dela nesta cena.\n\n- Ela já ter sido usada contra você anteriormente.\n\nAceite o segundo resultado, mantendo modificadores, vantagem e desvantagem, sem misturar dados. Não custa PE e só pode ser usada uma vez por teste. Não cria um TR inexistente, deslocamento ou resistência.\n\nO estudo precisa ser conhecimento estabelecido; ver um feitiço não ensina automaticamente toda a técnica. Execução Reservada e Antecipação Estudada têm reservas diárias independentes, ambas de Maestria usos.",
        5
      ],
      [11,122,"Inumaki",5],[11,123,"Descendente",5],[11,124,"marcante",5],[11,125,"",5],[11,126,"Uma vez por cena · Duas vezes por cena",5],
      [
        11,127,
        "Sua família cultiva uma comunicação atenta, feita de poucas palavras e sinais discretos. A imagem da serpente aparece nesse repertório e nos símbolos usados pela casa. Sua marcante reúne Entendimento Tácito e Linguagem da Serpente, com Leitura a Dois.\n\nEssa formação funciona com ou sem Fala Amaldiçoada. Não concede a técnica, obriga você a portar suas marcas ou impede o uso de linguagem comum.\n\nEntendimento Tácito.\n\nDurante um descanso longo, escolha um companheiro. Uma vez por cena, quando ambos fizerem o mesmo tipo de TR Físico ou de Espírito contra a mesma aplicação, podem usar o melhor resultado natural entre os dois, mantendo seus próprios bônus. Precisam estar a até 9 m e perceber um sinal um do outro.\n\nFaçam as rolagens normalmente, inclusive vantagem ou desvantagem. Depois de conhecer os resultados, antes das consequências, decida pelo uso. Comparem os d20 efetivamente escolhidos, sem recuperar dados descartados. O benefício não garante sucesso.\n\nExemplo: vocês obtêm 6 e 15 nos dados. Ambos podem usar 15; com bônus de +2 e +7, os totais ficam 17 e 22.\n\nLinguagem da Serpente.\n\nDurante um descanso longo, ensine aos companheiros que participarem um repertório de palavras comuns e gestos. Quem aprendeu consegue trocar mensagens com os demais participantes sem testes para transmitir ou compreender o sentido pretendido, inclusive mensagens não combinadas individualmente antes.\n\nQuem desconhece o código não compreende o sentido só por ouvir palavras ou ver gestos. A comunicação ainda pode ser percebida, e o código pode ser descoberto. Palavras precisam ser ouvidas; gestos, percebidos. As mensagens levam o tempo normal de comunicação e não substituem exigências verbais de capacidades ou concedem ações.\n\nAprender o código não torna todos os participantes companheiros de Entendimento Tácito. Escolher outro companheiro também não apaga o código aprendido pelos anteriores.\n\nLeitura a Dois.\n\nDuas vezes por cena, no total, antes de você ou o companheiro escolhido fazer um teste de Investigação, Intuição, Percepção, Persuasão, Enganação ou Intimidação, o executor pode usar o bônus da mesma perícia do outro no lugar do próprio.\n\nQuem oferece o bônus precisa ser treinado na perícia, acompanhar a situação e transmitir suas observações. Vocês devem estar conscientes, a até 9 m, acompanhando a situação e percebendo a comunicação necessária.\n\nO executor conserva seu d20 e as circunstâncias da tarefa. Os bônus não se somam, e o empréstimo não concede treino, especialização, requisitos ou outras capacidades do companheiro. Os dois usos são compartilhados pela dupla, em qualquer direção, e são independentes do uso de Entendimento Tácito.\n\nExemplo: você acompanha uma negociação e sinaliza quais argumentos usar. Se for treinado em Persuasão, seu companheiro pode trocar o bônus de +2 pelo seu +7. Com 9 no d20 dele, o total é 16, sem somar os dois bônus.\n\nNenhum componente concede outra ação ou tentativa, cobra PE adicionais ou oferece telepatia e sentidos compartilhados. Mantenha o tempo e os requisitos da tarefa; a orientação não revela pistas que nenhum dos dois percebeu.",
        5
      ],
      [12,122,"Duas Vidas",5],[12,123,"Encarnado",5],[12,124,"marcante",5],[12,125,"",5],[12,126,"Maestria vezes por descanso longo",5],
      [12,127,"Sua experiência reaparece em gestos, conhecimentos e maneiras de resolver problemas. Receba um treinamento adicional em perícia ou Ofício, novo e permanente, por Conhecimento Reavivado.\n\nPara a Reserva de Experiência, escolha duas perícias ou Ofícios treinados, distintos e fixos. O treino de Conhecimento Reavivado pode ser um deles. Maestria vezes por descanso longo, compartilhadas entre as duas escolhas, depois de rolar um teste de uma delas e antes das consequências, pode rolar 1d4 e somar ao total.\n\nNão custa ação ou PE adicionais. Só pode acrescentar um d4 por teste; o uso é gasto mesmo se o total continuar falhando. Resolva primeiro vantagem ou desvantagem e use o d20 escolhido. O d4 não muda seu resultado natural nem reabre consequências já aplicadas.\n\nA tarefa conserva ações, tempo, materiais e requisitos. A Reserva não vale para ataques, TRs, Iniciativa, Bloquear ou dados de dano e cura. Seu d4 é fixo; Maestria determina os usos, renovados ao concluir um descanso longo. Descanso curto, início de sessão ou dormir durante uma missão não renovam esse estoque.",5],
      [13,122,"Regeneração Orgânica",5],[13,123,"Híbrido",5],[13,124,"marcante",5],[13,125,"",5],[13,126,"Constituição ÷ 2 + 1 vezes por cena",5],
      [13,127,"Quando seus ferimentos se tornam graves, você concentra energia para recompor o próprio corpo. Pode usar esta capacidade metade da Constituição, arredondada para baixo, +1 vezes por cena, no máximo uma vez em cada turno seu.\n\nEnquanto tiver pelo menos 1 PV e até 30% da vida máxima atual, arredondados para baixo, use uma Ação Bônus e gaste de 1 PE até sua maior Classe disponível pelo nível. Escolha e pague antes de rolar: recupere 1d6 PV por PE gasto, até o máximo atual.\n\nConfira a vida ao ativar, sem contar vida temporária. A cura pode ultrapassar os 30%. Cada ativação consome um uso, qualquer que seja o gasto ou o resultado dos dados.\n\nA regeneração cura apenas você. Não recupera Integridade, não remove condições ou Sequelas nem recompõe partes perdidas. Não é Energia Reversa, feitiço ou Manejo, e funciona com Sem Técnica. Impedimentos e modificadores de cura aplicáveis continuam valendo.\n\nExemplo: com Constituição 3, você tem dois usos por cena. Se a vida máxima atual é 41, o limite para ativar é 12 PV. Com 12 PV e Classe 2 disponível, pode gastar 2 PE e rolar 2d6. Resultados 3 e 5 recuperam 8 PV, levando você a 20. Com 13 PV ou zero, não poderia iniciar essa regeneração.",5],
      [14,122,"Existência Artificial",5],[14,123,"Corpo Amaldiçoado",5],[14,124,"marcante",5],[14,125,"",5],[14,126,"Uma vez por dia",5],
      [
        14,127,
        "Energia amaldiçoada sustenta a consciência no seu corpo construído. Você não precisa comer, beber, respirar ou dormir, embora possa comer e beber por vontade própria. Não adquire estágios de Exaustão e é imune a Envenenado.\n\nIsso não concede resistência ao dano Veneno ou imunidade a outras condições. Dispensar respiração evita a falta de ar; calor, pressão e substâncias que danifiquem a estrutura continuam funcionando. Uma capacidade ainda pode impor Inconsciente. Dano, Integridade, Sequelas, derrota e morte seguem suas regras.\n\nRepouso.\n\nQualquer local conta como ambiente propício para seus descansos curtos e longos. Os demais requisitos permanecem: poder parar em segurança no curto e encerrar a missão com oportunidade de repousar no longo. O benefício vale só para você.\n\nPode permanecer consciente e em vigília passiva durante o repouso, usando seus sentidos normalmente. Isso não oferece detecção automática nem permite trabalhar, combater ou manter tarefas incompatíveis com o descanso. Interrupções seguem as regras gerais.\n\nPara renovar usos por dia, um repouso equivalente ao sono exigido pela regra geral substitui dormir. A mesma pausa não renova habilidades várias vezes nem se torna descanso longo por essa permissão.\n\nRecuperação da estrutura.\n\nEnergia Reversa e curas derivadas dela não recuperam sua vida. Efeitos destinados apenas a restaurar tecido vivo também não reparam sua estrutura. Técnicas e capacidades cuja regra alcance explicitamente corpos construídos funcionam dentro de seus limites.\n\nSeu reparo segue Reparo do corpo. Qualquer pessoa treinada no ofício compatível pode fazê-lo, inclusive você, se estiver capaz e tiver ferramentas e materiais adequados. Não precisa ser seu criador ou possuir um vínculo especial. Reparar não restaura um núcleo destruído, não devolve a vida nem fabrica poderes.\n\nManutenção Precisa.\n\nUma vez por dia, quando um teste para reparar você durante um descanso curto falhar, quem faz o reparo pode repetir a rolagem e deve aceitar o novo resultado.\n\nÉ a mesma tentativa. No sucesso, recupere apenas a quantidade prevista pelo reparo, uma única vez. O uso diário pertence a você; trocar de reparador não o renova. Também pode usar o benefício ao reparar a si mesmo, se for qualificado e capaz.",
        5
      ],
      [15,122,"Ataque sem Prenúncio",5],[15,123,"Restrição Celestial · Sem Energia",5],[15,124,"marcante",5],[15,125,"",5],[15,126,"Uma vez por turno seu",5],
      [
        15,127,
        "Seu adversário percebe o golpe, mas não recebe o sinal energético que esperava para antecipá-lo. Uma vez por turno seu, depois de declarar um ataque que já possa realizar e de o defensor escolher entre Defesa e Bloquear, quando essa escolha couber, anuncie Ataque sem Prenúncio e gaste 2 PE adicionais, antes do d20 do ataque, do TR ou da aplicação Automática. Não exige outra ação. Pague também o custo do ataque ou da Kata; errar não devolve os custos.\n\nA marcante abrange ataques comuns corpo a corpo, com arma ou desarmados, e Katas ofensivas por acerto, TR ou resultado Automático, inclusive Katas à distância ou transportadas por um golpe. Escolha um defensor. O benefício direto alcança apenas a primeira resolução ofensiva contra ele naquela execução, sem aplicações automáticas nos outros ataques, alvos ou pulsações. Não concede um ataque novo nem modifica a montagem.\n\nAntecipação e bloqueio.\n\nSe o defensor puder perceber energia amaldiçoada e ainda não reconhecer por estudo essa execução sua:\n\n- O anúncio impede uma Reação do defensor provocada pela declaração dessa execução que seria resolvida antes da rolagem de acerto, do TR escolhido ou da aplicação Automática inicial, conforme o procedimento usado. Se ele já tiver declarado uma Reação dessas contra aquela execução, o anúncio a cancela, sem gastar a Reação dele.\n\n- Se a resolução admitir Bloquear e ele tiver escolhido essa defesa, faz a rolagem com desvantagem, seguindo os dois conjuntos completos e os extremos de Aparar e Brecha.\n\nO TR mantém dado, CD e modificadores. Automáticos não ganham teste nem ignoram imunidades, resistências ou requisitos. Benefícios sem gasto de Reação continuam disponíveis. Numa resolução com acerto seguido de TR, a marcante não acrescenta penalidade ao TR.\n\nDefesa fixa, proteção, efeitos já ativos e respostas posteriores ao erro, acerto ou dano conservam suas regras. Uma ativação impedida não consome a reserva de Reação. A escolha de Defesa ou Bloquear permanece antes do d20 do ataque; o anúncio vem entre essa escolha e o d20. Depois do anúncio, o defensor não pode trocar a escolha.\n\nIntervenções de terceiros continuam disponíveis. Se outra criatura assumir o ataque, confira a suscetibilidade dela, sem desfazer a intervenção já resolvida ou transferir o reconhecimento do alvo anterior.\n\nEstudar a execução.\n\nDepois de ser alvo efetivo de uma execução sua e percebê-la por visão ou sentido equivalente, o adversário pode usar Estudar enquanto consegue observar você. Gasta a ação de Estudar — normalmente Padrão, salvo permissão válida — e faz seu teste inicial, com a perícia e a CD do procedimento. Precisa passar para iniciar o reconhecimento. Não há segunda rolagem para habilitá-lo nem outra informação livre pelo mesmo gasto.\n\nNa falha, a ação foi gasta e o reconhecimento não começa; novas tentativas seguem Estudar. Seus outros usos, inclusive informações evidentes sem teste, permanecem iguais.\n\nA execução pode ter acertado, errado, sido bloqueada ou resistida. Não exige dano nem pagamento de Ataque sem Prenúncio naquela execução. Apenas observar outra pessoa ou receber dano transferido sem ser alvo não equivale a enfrentá-la.\n\nDepois do primeiro Estudar bem-sucedido, o defensor neutraliza a marcante contra as execuções suas que já enfrentou. Cada execução inédita ainda pode receber o benefício na primeira tentativa; depois de enfrentá-la e percebê-la, ele passa a reconhecê-la, sem novo estudo, teste ou limite de Katas por estudo.\n\nMemória entre encontros.\n\nRegistre ataques comuns por tipo ou perfil de arma, não por exemplar. Outra cópia equivalente não renova a novidade. Ataques comuns desarmados formam um único perfil: trocar soco por chute não o torna inédito.\n\nKatas são reconhecidas separadamente. Conhecer uma arma não revela as Katas ainda desconhecidas feitas com ela. Mudar apenas números, Classe, custo ou arma compatível não torna a mesma Kata inédita. Uma mudança real de funcionamento pode definir outra aplicação, previamente identificada no repertório e adquirida normalmente.\n\nCada defensor conserva o estudo e as execuções reconhecidas daquele Restringido entre encontros. Combate, missão ou descanso não apagam o aprendizado, que não se transfere automaticamente a aliados ou a outro Restringido. Reconhecimento protege contra esta marcante, não contra o dano e os demais efeitos da execução.\n\nExemplo: uma Kata de 3 PE com Ataque sem Prenúncio custa 5 PE. Resolva a Kata normalmente, sem acrescentar dano de arma ou de Estímulo Muscular quando suas fontes não permitirem. Se o adversário já estudou você, mas nunca enfrentou essa Kata, a primeira execução ainda pode receber o benefício; depois de percebê-la, ele a reconhece nos reencontros.",
        5
      ],
      [16,122,"Corpo Debilitado",5],[16,123,"Restrição Celestial · Restrição corporal",5],[16,124,"marcante",5],[16,125,"",5],[16,126,"Passiva",5],
      [
        16,127,
        "Sua Restrição comprometeu seu corpo desde o nascimento: o braço direito e as partes das pernas abaixo dos joelhos não se desenvolveram, você não possui sensibilidade abaixo da cintura e convive com dor constante. Sua pele é tão frágil que até o luar pode queimá-la. Este exemplo tem Mechamaru como referência; proteção, cuidados e meios de agir além do corpo fazem parte do cotidiano.\n\nSua Defesa fica fixada em 0, sem alteração por bônus ou penalidades numéricos, e você não pode Bloquear. Cobertura total, impedimentos de alvo, resistências, imunidades, redução de dano e vida temporária seguem suas regras. A limitação não concede acerto ou crítico automático nem passa a um intermediário com Defesa própria.\n\nSeu deslocamento próprio é 0 m, e você tem somente uma mão funcional. Depende de transporte, assistência ou recursos adequados para se locomover e realizar tarefas que exijam os membros ausentes. Falha automaticamente nos TRs de Vigor e Físico exigidos do corpo real, inclusive no TR de Concentração após dano: quando ele for exigido, o efeito termina.\n\nPele e repouso.\n\nAo final de cada turno seu, se alguma pele estiver exposta à luz do sol ou da lua, sofra 1d4 de dano Radiante, sem TR. Fora de combate, aplique a cada rodada de exposição contínua. Uma cobertura opaca que impeça a luz de alcançar toda a pele exposta evita o dano. Iluminação artificial não aciona essa regra por si só.\n\nPara descansar em ambiente propício, precisa de estrutura protegida, materiais e cuidados adequados, registrados na ficha. Sem eles, use o descanso fora de ambiente propício. Pessoas ou recursos compatíveis da técnica podem prestar a assistência.\n\nCura e descanso recuperam recursos normalmente, mas não removem as limitações congênitas. As consequências pertencem ao corpo real; não passam automaticamente a marionetes ou intermediários. Um teste exigido de você continua sujeito à penalidade, e os meios de compensá-la seguem suas próprias regras.\n\nSaída Elevada.\n\nSeus feitiços comuns da técnica de Classe 1 ou maior recebem pontos adicionais de montagem iguais à metade da Classe utilizada, arredondada para baixo, mínimo 1. Esses pontos servem somente para Melhorias, considerando os descontos normais.\n\nClasse utilizada | 1 | 2 | 3 | 4 | 5 | 6 | 7\nPontos adicionais | 1 | 1 | 1 | 2 | 2 | 3 | 3\n\nClasse, custo-base em PE, quantidade permitida de Melhorias, acessos às Famílias e demais tetos permanecem. Pontos adicionais não usados se perdem; não viram diretamente dano, cura ou vida temporária. Podem preservar pontos normais que seriam gastos em Melhorias, dentro dos limites existentes.\n\nSaída Elevada não vale para Máximas ou Manejos. Receber os pontos não acrescenta custo em PE; os custos específicos do feitiço continuam normais.",
        5
      ],
      [17,122,"Corpo Quebradiço",5],[17,123,"Restrição Celestial · Restrição corporal",5],[17,124,"marcante",5],[17,125,"",5],[17,126,"Passiva",5],
      [
        17,127,
        "Sua Restrição preservou seus membros, mas deixou a estrutura incapaz de sustentar o próprio peso e o esforço de uma luta. Mesmo saudável, você depende de apoio para acomodar o corpo e de transporte para se deslocar. Ferimentos que outra pessoa suportaria podem colocar sua vida em risco.\n\nSua Defesa fica fixada em 0, sem alteração por bônus ou penalidades numéricos, e você não pode Bloquear. Cobertura total, impedimentos de alvo, resistências, imunidades, redução de dano e vida temporária seguem suas regras. A limitação não concede acerto ou crítico automático nem passa a um intermediário com Defesa própria.\n\nSeu deslocamento próprio é 0 m, e sua vida máxima é metade da normal, arredondada para baixo, mínimo 1. A redução também se aplica aos aumentos futuros. Você não consegue caminhar, correr, saltar, escalar ou nadar por esforço próprio.\n\nFalha automaticamente em testes de Força e TRs Físicos exigidos do corpo real. Ataques que dependam do esforço físico desse corpo também falham, mesmo usando Destreza. Seus membros não sustentam seu peso, não empurram nem arrastam cargas pesadas e não carregam outra criatura, mesmo sem rolagem.\n\nAs mãos permitem manipulação leve, como escrever, segurar pequenos objetos e fazer gestos de uma técnica compatível. Uma conjuração não falha apenas por usar Força ou Destreza no cálculo. TRs de Vigor seguem normalmente, inclusive os de Concentração.\n\nCuidados.\n\nPara descansar em ambiente propício, precisa de apoio corporal, materiais e cuidados adequados, registrados na ficha. O atendimento pode ser feito por alguém treinado em Medicina, inclusive você, se estiver treinado, capaz e com os meios necessários. Sem isso, use o descanso fora de ambiente propício.\n\nCura e descanso recuperam vida normalmente dentro do máximo reduzido, sem remover as limitações congênitas. As consequências pertencem ao corpo real, sem passar automaticamente a marionetes ou intermediários. Transporte e recursos compatíveis seguem suas regras. A fragilidade não acrescenta vulnerabilidade a dano ou queimaduras por luz.\n\nSaída Elevada.\n\nSeus feitiços comuns da técnica de Classe 1 ou maior recebem pontos adicionais de montagem iguais à metade da Classe utilizada, arredondada para baixo, mínimo 1. Esses pontos servem somente para Melhorias, considerando os descontos normais.\n\nClasse utilizada | 1 | 2 | 3 | 4 | 5 | 6 | 7\nPontos adicionais | 1 | 1 | 1 | 2 | 2 | 3 | 3\n\nClasse, custo-base em PE, quantidade permitida de Melhorias, acessos às Famílias e demais tetos permanecem. Pontos adicionais não usados se perdem; não viram diretamente dano, cura ou vida temporária. Podem preservar pontos normais que seriam gastos em Melhorias, dentro dos limites existentes.\n\nSaída Elevada não vale para Máximas ou Manejos. Receber os pontos não acrescenta custo em PE; os custos específicos do feitiço continuam normais.",
        5
      ],
      [18,122,"Corpo Exaurido",5],[18,123,"Restrição Celestial · Restrição corporal",5],[18,124,"marcante",5],[18,125,"",5],[18,126,"Passiva",5],
      [
        18,127,
        "Seu organismo permanece debilitado. Você conserva a capacidade de falar, fazer tarefas leves e caminhar devagar, mas não sustenta o esforço de uma luta. Ferimentos consomem a pouca autonomia física que possui, e recuperar-se exige cuidados prolongados.\n\nSua Defesa fica fixada em 0, sem alteração por bônus ou penalidades numéricos, e você não pode Bloquear. Cobertura total, impedimentos de alvo, resistências, imunidades, redução de dano e vida temporária seguem suas regras. A limitação não concede acerto ou crítico automático nem passa a um intermediário com Defesa própria.\n\nFalha automaticamente nos TRs de Vigor e Físico exigidos do corpo real, inclusive Concentração quando Vigor for exigido. Testes e ataques que dependam do esforço físico desse corpo também falham automaticamente.\n\nSeu deslocamento próprio é limitado a 4,5 m, em movimento leve no chão. Não consegue correr, saltar, escalar, nadar, sustentar o peso pelos braços, empurrar ou arrastar cargas pesadas, nem carregar outra criatura por esforço próprio, mesmo sem rolagem. Ainda pode escrever, manipular objetos leves e fazer gestos de uma técnica compatível; usar um atributo físico na conjuração não a faz falhar por si só.\n\nCom metade da vida máxima ou menos, arredondada para baixo, seu deslocamento próprio passa a 0 m. Recuperar vida acima do limite devolve o deslocamento permitido. Isso não aplica Atordoado, retira ações ou consciência, nem impede transporte.\n\nCura e repouso.\n\nEfeitos de cura recuperam metade da vida normal, arredondada para baixo, mínimo 1 quando positiva. Um descanso longo em ambiente propício recupera 25% da vida máxima, arredondados para baixo, mínimo 1, somados à vida atual até o máximo. Fora de ambiente propício, o descanso longo não recupera vida. Os demais recursos e efeitos, inclusive PE, seguem normalmente.\n\nO ambiente propício exige cuidados e meios adequados à sua condição, registrados na ficha. Os 25% do descanso não são divididos novamente; efeitos de cura usados durante ele continuam pela metade. Descanso curto não recupera vida por si só, e uma mesma pausa não pode ser repetida para multiplicar a recuperação.\n\nCura comum não remove a condição congênita. Exaustão adquirida segue suas regras, sem degrau permanente adicional. As consequências pertencem ao corpo real, sem passar automaticamente a marionetes ou intermediários; testes exigidos de você continuam sujeitos às limitações.\n\nSaída Elevada.\n\nSeus feitiços comuns da técnica de Classe 1 ou maior recebem pontos adicionais de montagem iguais à metade da Classe utilizada, arredondada para baixo, mínimo 1. Esses pontos servem somente para Melhorias, considerando os descontos normais.\n\nClasse utilizada | 1 | 2 | 3 | 4 | 5 | 6 | 7\nPontos adicionais | 1 | 1 | 1 | 2 | 2 | 3 | 3\n\nClasse, custo-base em PE, quantidade permitida de Melhorias, acessos às Famílias e demais tetos permanecem. Pontos adicionais não usados se perdem; não viram diretamente dano, cura ou vida temporária. Podem preservar pontos normais que seriam gastos em Melhorias, dentro dos limites existentes.\n\nSaída Elevada não vale para Máximas ou Manejos. Receber os pontos não acrescenta custo em PE; os custos específicos do feitiço continuam normais.",
        5
      ],
      [19,122,"Manifestação Instintiva",5],[19,123,"Latente",5],[19,124,"menor",5],[19,125,"",5],[19,126,"Passiva",5],[19,127,"Uma função da sua técnica se manifesta antes de você aprender a desenvolvê-la pelo método comum. Escolha um Talento de Categoria de Efeito 1 do catálogo, compatível com sua técnica ou semente de Sem Técnica, que ainda não possua.\n\nEle não ocupa espaço conhecido nem conta entre os cinco Talentos pagos. Mantenha seus requisitos, custos e limites. A escolha fica fixa, sem duplicação, evolução gratuita de Categoria ou troca livre. Categoria de Efeito não é Classe de conjuração.",5],[20,122,"Prontidão Instintiva",5],[20,123,"Latente",5],[20,124,"menor",5],[20,125,"",5],[20,126,"Passiva",5],[20,127,"Você reage ao perigo antes de organizar uma resposta. Role Iniciativa com vantagem, conservando Destreza e os demais modificadores normais.",5],[21,122,"Foco Visceral",5],[21,123,"Latente",5],[21,124,"menor",5],[21,125,"",5],[21,126,"Maestria vezes por cena",5],[21,127,"Você se apega ao que está fazendo, mesmo sob pressão. Maestria vezes por cena, antes de um TR para manter Concentração após sofrer dano, pode obter vantagem nessa rolagem. Cada uso beneficia um TR e é gasto mesmo na falha.",5],[22,122,"Aptidão Intuitiva",5],[22,123,"Latente",5],[22,124,"menor",5],[22,125,"",5],[22,126,"Uma vez por cena",5],[22,127,"Você encontra caminhos que ainda não aprendeu a explicar. Uma vez por cena, antes de um teste de perícia em que não tenha treino, acrescente sua Maestria ao resultado. Vale apenas para a tentativa; não concede treino nem dispensa requisitos. Não se aplica a Ofícios, ataques ou TRs.",5],[23,122,"Presença Bruta",5],[23,123,"Latente",5],[23,124,"menor",5],[23,125,"",5],[23,126,"Uma vez por cena",5],
      [23,127,"Sua energia manifesta uma intensidade difícil de ignorar. Uma vez por cena, ao manifestá-la de forma perceptível pelo alvo, declare o uso antes de um teste de Intimidação ou Provocar e acrescente sua Maestria, além do bônus normal. As duas opções compartilham o uso e conservam suas ações e efeitos.",5],[24,122,"Retomar o Controle",5],[24,123,"Latente",5],[24,124,"menor",5],[24,125,"",5],[24,126,"Uma vez por cena",5],[24,127,"Você força seu corpo e sua energia a responder novamente. Uma vez por cena, use uma Ação Bônus para fazer imediatamente, com vantagem, um TR para encerrar uma condição que já permita essa tentativa no fim do seu turno. Escolha uma condição e mantenha CD e modificadores.\n\nSe falhar, conserva a tentativa normal no fim do turno. O benefício não devolve ações já perdidas.",5],[25,122,"Certeza Momentânea",5],[25,123,"Latente",5],[25,124,"menor",5],[25,125,"",5],[25,126,"Uma vez por dia",5],[25,127,"Por um instante, a hesitação desaparece. Uma vez por dia, antes de rolar um teste de perícia treinada, declare o uso. Se o resultado usado do d20 for menor que 10, trate-o como 10 e some os modificadores normais. O uso é gasto mesmo se o dado já mostrar 10 ou mais. Não se aplica a Ofícios, ataques ou TRs.",5],[26,122,"Gambiarra",5],[26,123,"Latente",5],[26,124,"menor",5],[26,125,"",5],[26,126,"Uma vez por dia",5],[26,127,"Você aprendeu a resolver problemas com o que tinha à mão. Uma vez por dia, antes de um teste de Ofício em que não tenha treino, pode realizar a tentativa como treinado, somando sua Maestria, e usar objetos disponíveis como ferramentas improvisadas adequadas à tarefa.\n\nMantenha tempo, materiais e demais requisitos. O uso vale para uma tentativa e é gasto mesmo na falha. Não pode criar itens, realizar invocações ou obter aquisições permanentes por este benefício.",5],[27,122,"Memória Corporal",5],[27,123,"Receptáculo",5],[27,124,"menor",5],[27,125,"",5],[27,126,"Uma vez por dia",5],
      [27,127,"Uma vez por dia, use uma Ação Bônus para receber treino em uma perícia até o fim da cena. Não concede especialização, treino permanente ou bônus adicional numa perícia já treinada. Ofícios, TRs e Aptidões ficam fora.",5],[28,122,"Traço Incorporado",5],[28,123,"Receptáculo",5],[28,124,"menor",5],[28,125,"",5],[28,126,"Passiva",5],[28,127,"Receba um Talento passivo de Categoria de Efeito 1, fixo e compatível com sua ficha. Cumpra seus requisitos e limites. Ele fica fora dos espaços conhecidos e dos cinco Talentos pagos, como Manifestação Instintiva, sem duplicação ou evolução gratuita. Não concede uma Aptidão ou outra Regra.",5],[29,122,"Voz Intrusa",5],[29,123,"Receptáculo",5],[29,124,"menor",5],[29,125,"",5],[29,126,"Uma vez por cena",5],[29,127,"A outra voz atravessa sua fala e provoca o adversário. Uma vez por cena, durante seu turno, pode usar uma Ação de Movimento para Provocar. Mantenha rolagem, TR do alvo, requisitos, efeitos e riscos da ação. Não recebe deslocamento junto dessa ação; o uso normal de Provocar continua disponível.",5],[30,122,"Foco Inscrito",5],[30,123,"Receptáculo",5],[30,124,"menor",5],[30,125,"",5],[30,126,"Uma vez por cena",5],[30,127,"Uma vez por cena, após falhar em um TR para manter Concentração por ter sofrido dano, repita o teste e aceite o segundo resultado. Conserve a CD e os modificadores. Não permite duas Concentrações nem restaura um efeito encerrado por outro motivo.",5],[31,122,"Reserva Residual",5],[31,123,"Receptáculo",5],[31,124,"menor",5],[31,125,"",5],[31,126,"Uma vez por dia",5],[31,127,"Uma vez por dia, depois de resolver o uso que gastou seus últimos PE comuns e temporários, receba Constituição ou Essência + Maestria em PE temporários, sem ação. Escolha o atributo no uso e use seu valor inteiro. A reserva dura até o fim da cena e respeita o teto de metade dos PE máximos.",5],[32,122,"Orientação Instintiva",5],[32,123,"Receptáculo",5],[32,124,"menor",5],[32,125,"",5],[32,126,"Uma vez por dia",5],
      [32,127,"Uma vez por dia, após falhar em um teste de perícia seu, repita a rolagem com os mesmos modificadores e aceite o segundo resultado. Não exige outra ação e não inclui ataques, TRs ou Ofícios.",5],[33,122,"Conselho Interior",5],[33,123,"Receptáculo",5],[33,124,"menor",5],[33,125,"Coexistência",5],[33,126,"Uma vez por cena",5],[33,127,"Requisito: Coexistência. Uma vez por cena, após falhar em Intuição ou Ocultismo, repita o teste e aceite o segundo resultado. As duas perícias compartilham o uso. A presença interpreta os indícios disponíveis; não lê pensamentos nem oferece conhecimento infalível.",5],[34,122,"Vontade de Cárcere",5],[34,123,"Receptáculo",5],[34,124,"menor",5],[34,125,"Conflito",5],[34,126,"Uma vez por cena",5],[34,127,"Requisito: Conflito. Uma vez por cena, após falhar em um TR que o efeito já permita para evitar ou encerrar Enfeitiçado ou Amedrontado, repita o teste e aceite o segundo resultado. As condições compartilham o uso.\n\nNão cria um TR novo, antecipa uma tentativa de saída ou devolve ações consumidas.",5],[35,122,"Cofre da Família",5],[35,123,"Descendente",5],[35,124,"menor",5],[35,125,"Zenin",5],[35,126,"Passiva",5],[35,127,"Exclusiva Zenin. Receba uma ferramenta amaldiçoada emprestada por vez, de grau igual ou inferior à sua patente reconhecida, até grau 1. Para trocar, volte ao cofre e devolva a anterior.\n\nArmas de grau 1 exigem feitos que justifiquem o acesso e autorização do mestre. Ferramentas especiais ficam fora da concessão. Mantenha os requisitos próprios da ferramenta; nível não substitui patente.",5],[36,122,"Ensaio Partilhado",5],[36,123,"Descendente",5],[36,124,"menor",5],[36,125,"Kamo",5],[36,126,"No descanso curto",5],
      [36,127,"Exclusiva Kamo. Durante um descanso curto, pode rerrolar uma vez cada resultado de Execução Ensaiada ainda disponível, com um d20 por resultado, aceitando os novos valores. Não recupera resultados gastos, repete o ensaio de três dados ou muda as competências escolhidas.\n\nAo concluir um descanso longo e realizar o ensaio normal, pode entregar um dos resultados a um aliado treinado na perícia ou Ofício ensaiado, que tenha praticado com você. Retire o resultado da sua reserva. O aliado o usa antes da rolagem, substituindo um d20 pelo procedimento do ensaio. Não transmite TR, treino ou a capacidade de rerrolar durante descanso curto.\n\nO resultado é consumido no uso e expira ao fim do dia em jogo ou no próximo descanso longo do Kamo, o que vier primeiro.",5],[37,122,"Método Reescrito",5],[37,123,"Descendente",5],[37,124,"menor",5],[37,125,"Gojo",5],[37,126,"No descanso longo",5],[37,127,"Exclusiva Gojo. Ao concluir um descanso longo, pode substituir uma capacidade da lista de Execução Reservada por outro feitiço ou Manejo já conhecido. Não aprende nova capacidade, amplia a lista ou renova os usos diários por esta menor.",5],[38,122,"Círculo Íntimo",5],[38,123,"Descendente",5],[38,124,"menor",5],[38,125,"Inumaki",5],[38,126,"No descanso longo",5],[38,127,"Exclusiva Inumaki. No descanso longo, escolha dois companheiros, em vez de um. A cada aplicação da marcante, decida com qual deles cooperar.\n\nOs limites continuam compartilhados: um Entendimento Tácito e duas Leituras a Dois por cena. Você participa de cada dupla; os efeitos não alcançam os três ao mesmo tempo nem os dois companheiros sem você. Mantenha os demais requisitos.",5],[39,122,"Notas de Família",5],[39,123,"Descendente",5],[39,124,"menor",5],[39,125,"",5],[39,126,"Uma vez por cena",5],
      [39,127,"Uma vez por cena, depois de falhar em História ou Ocultismo, consulte anotações familiares para obter uma informação verdadeira, mas parcial, pertinente à pergunta e ao conhecimento registrado. A falha no objetivo completo permanece. Não fornece algo que não possa constar das anotações.",5],[40,122,"Autoridade de Berço",5],[40,123,"Descendente",5],[40,124,"menor",5],[40,125,"",5],[40,126,"Uma vez por cena",5],[40,127,"Uma vez por cena, antes de rolar, pode usar Hierarquia no lugar de Persuasão ou Intimidação numa interação do meio jujutsu apoiada em obrigações, precedentes ou relações institucionais. Precisa ser treinado em Hierarquia. Não força obediência.",5],[41,122,"Bagagem Prevenida",5],[41,123,"Descendente",5],[41,124,"menor",5],[41,125,"",5],[41,126,"Uma vez na missão",5],[41,127,"Ao preparar uma missão, reserve dinheiro próprio e 0,5 de Volume. Uma vez na missão, revele um item comum comprado no preparo, de até 0,5 de Volume e preço dentro da reserva, descontando-o dela. Não permite armas, proteções, itens amaldiçoados ou restritos.\n\nGrau reconhecido no preparo | Máximo de dinheiro próprio reservado\nGrau 4 | ¥10.000\nGrau 3 | ¥20.000\nGrau 2 | ¥30.000\nGrau 1 | ¥40.000\nEspecial | ¥50.000\n\nO limite acompanha grau ou patente, não nível ou Maestria. Use as equivalências de patentes intermediárias já estabelecidas na campanha. A menor não fornece dinheiro, mais Volume ou usos extras.",5],[42,122,"Palavra Empenhada",5],[42,123,"Descendente",5],[42,124,"menor",5],[42,125,"",5],[42,126,"Uma vez por descanso longo",5],[42,127,"Uma vez por descanso longo, após falhar em Persuasão numa negociação viável, ofereça sua palavra e reputação como garantia. O mestre apresenta uma condição adicional concreta: pagamento, serviço ou concessão. Você pode aceitar ou recusar; cumprir a condição conclui o acordo sem repetir aquele teste.\n\nNão torna um pedido inviável aceitável nem fornece dinheiro para pagar a condição.",5],[43,122,"Fundamento Incorporado",5],
      [43,123,"Descendente",5],[43,124,"menor",5],[43,125,"",5],[43,126,"Uma vez por dia",5],[43,127,"Uma vez por dia, antes da rolagem, pode usar 10 no lugar de um d20 num teste da perícia recebida pela base da Origem, somando seus bônus. Com vantagem ou desvantagem, role o outro d20 e resolva normalmente.\n\nNão é um piso aplicado depois do resultado. O benefício alcança a perícia escolhida, não todas as opções da base, ataques ou TRs.",5],[44,122,"Treino de Armas da Casa",5],[44,123,"Descendente",5],[44,124,"menor",5],[44,125,"",5],[44,126,"Passiva",5],[44,127,"Receba treino permanente em duas categorias de arma à escolha, como Yumi e Lâmina Longa. Não recebe duas listas inteiras de armas simples ou marciais. A menor não fornece equipamento, troca de atributo ou dispensa de requisitos de aquisição.",5],[45,122,"Especialidade Antiga",5],[45,123,"Encarnado",5],[45,124,"menor",5],[45,125,"",5],[45,126,"Passiva",5],[45,127,"Ao alcançar o nível 10, torne-se especialista na perícia ou Ofício escolhido na criação e recebido por Conhecimento Reavivado, sem precisar escolher Corpo no Marco. Use o bônus normal de especialização: metade da Maestria, arredondada para baixo. Não acumula outra especialização na mesma competência.",5],[46,122,"Guarda Reaprendida",5],[46,123,"Encarnado",5],[46,124,"menor",5],[46,125,"",5],[46,126,"Uma vez por cena",5],[46,127,"Uma vez por cena, depois de rolar Bloquear e antes das consequências, pode rerrolar um dos d10, aceitando o novo resultado. Conserve o outro dado e os modificadores; resolva Aparar e Brecha pelos dados finais. Não exige ação, Reação ou PE adicionais.\n\nCom desvantagem, role os dois conjuntos e rerrole um único d10 de um deles antes de selecionar o conjunto final. Depois aplique normalmente desvantagem, Aparar e Brecha.",5],[47,122,"Percepção de Contorno",5],[47,123,"Encarnado",5],[47,124,"menor",5],[47,125,"",5],[47,126,"Passiva",5],
      [47,127,"Você tem visão às cegas a 3 m × Maestria, passivamente: 3, 6, 9 ou 12 m. Use esse sentido para perceber e atacar conforme suas regras, sem depender de Sentir Energia.\n\nObstáculos sólidos continuam bloqueando. Não oferece leitura fina, percepção da alma, ficha de técnica ou dispensa de exigências que peçam especificamente seus olhos. Furtividade continua possível quando os sinais alcançados puderem ser ocultados.",5],[48,122,"Experiência Transmitida",5],[48,123,"Encarnado",5],[48,124,"menor",5],[48,125,"",5],[48,126,"Gasta a Reserva de Experiência",5],[48,127,"Depois de um aliado a até 9 m rolar um teste de qualquer perícia em que você seja treinado, antes das consequências, pode gastar um uso da sua Reserva de Experiência para acrescentar 1d4 ao resultado dele. Ele precisa ouvir e compreender sua orientação. Não exige outra ação ou PE, com no máximo um d4 de Reserva por teste.\n\nA perícia não precisa ser uma das duas escolhidas para seus usos pessoais. O aliado não precisa ter treino, mas continua sujeito aos requisitos da tarefa; a orientação não supre treino obrigatório ausente. Não alcança Ofícios, ataques ou TRs.\n\nVocê e os aliados gastam o mesmo estoque de Maestria usos por descanso longo. Seus usos pessoais continuam limitados às duas competências fixas.",5],[49,122,"Memória Testemunha",5],[49,123,"Encarnado",5],[49,124,"menor",5],[49,125,"",5],[49,126,"Uma vez por dia",5],[49,127,"Uma vez por dia, dedique 1 minuto a revisitar uma cena que você ou seu hospedeiro realmente presenciou. Faça ao mestre até três perguntas sobre detalhes que poderiam ter sido percebidos naquela ocasião, sem teste de lembrança.\n\nAs respostas recuperam o que a lembrança permite. Não criam acontecimentos, não revelam algo imperceptível na ocasião nem transformam uma impressão equivocada em conhecimento do que estava oculto. O uso é gasto ao iniciar a consulta; as perguntas pertencem à mesma cena.",5],[50,122,"Vivência de Outra Era",5],[50,123,"Encarnado",5],
      [50,124,"menor",5],[50,125,"",5],[50,126,"Uma vez por cena",5],[50,127,"Uma vez por cena, antes de um teste da perícia escolhida na base do Encarnado — História, Ocultismo, Investigação ou Intimidação —, pode fazê-lo com vantagem, sem ação ou PE adicionais. A escolha é a registrada na criação e não muda entre usos.",5],[51,122,"Experiência Preservada",5],[51,123,"Encarnado",5],[51,124,"menor",5],[51,125,"",5],[51,126,"Uma vez por cena",5],[51,127,"Uma vez por cena, se usar a Reserva de Experiência num teste próprio e ele continuar falhando depois do d4, esse uso da Reserva não é consumido. A falha e suas consequências acontecem normalmente, sem nova rolagem ou tentativa.\n\nVocê precisa ter um uso disponível para empregar a Reserva. A preservação não aumenta o saldo acima do máximo e não vale para o d4 concedido a um aliado.",5],[52,122,"Anatomia Suplementar",5],[52,123,"Híbrido",5],[52,124,"menor",5],[52,125,"",5],[52,126,"Passiva",5],[52,127,"Escolha uma alteração:\n\n- Apêndice preênsil: braço auxiliar, cauda ou tentáculo que segura um objeto de até 1 Volume e faz manipulações simples com as ações normais. Deixa as mãos livres, sem conceder ataques, escudo ou gestos adicionais.\n\n- Olho adicional: escolha sua posição. Enquanto estiver exposto, você pode enxergar por ele. A até 9 m, enxerga na penumbra e na escuridão comum sem a penalidade por falta de luz, mas não distingue cores no escuro. Os demais impedimentos de visão continuam valendo.\n\nUma boca extra usada em combate é representada por Presas ou boca predatória, abaixo.",5],[53,122,"Armamento Orgânico",5],[53,123,"Híbrido",5],[53,124,"menor",5],[53,125,"",5],[53,126,"Passiva",5],
      [53,127,"Seu corpo oferece uma forma própria de atacar. Cada aquisição dá um perfil, usando seu dado desarmado atual, que acompanha sua evolução, sem acrescentar outro dado.\n\nPerfil | Dano | Benefício\nGarras ou lâminas ósseas | Cortante | Fineza: pode usar Destreza no acerto e no dano.\nPresas ou boca predatória | Perfurante | Pode Agarrar com a boca, mantendo as mãos livres. Usa a manobra normal, substituindo um ataque e sem causar dano nessa tentativa.\nPunhos nodosos ou chifre rombudo | Concussão | Rompe: vantagem contra objetos e estruturas que consiga danificar.\nMembro extensível | Concussão | Ataques feitos com esse membro têm alcance permanente de 3 m.\n\nDois perfis oferecem alternativas; suas propriedades não se somam no mesmo golpe. Membro Extensível vale também para ataques de oportunidade e Reações que já permitam atacar. Não exige outra ação, não concede ataques extras nem exige manter o membro esticado o tempo todo.\n\nO alcance adicional não amplia armas empunhadas ou manobras: Agarrar, Derrubar e Empurrar conservam suas distâncias normais.",5],
      [54,122,"Locomoção Adaptada",5],[54,123,"Híbrido",5],[54,124,"menor",5],[54,125,"",5],[54,126,"Passiva",5],[54,127,"Escolha uma adaptação:\n\n- Aderência: deslocamento de escalada igual ao normal, inclusive em paredes lisas e tetos, com uma mão livre e apoio dos pés.\n\n- Anfíbio: respiração aquática e deslocamento de natação igual ao normal.\n\n- Planagem: use sua Reação ao começar uma queda, com os braços livres, para descer sem dano de altura. Pode avançar horizontalmente até a altura perdida, limitado ao deslocamento normal por queda. Não permite subir ou pairar.",5],[55,122,"Bolsa Orgânica",5],[55,123,"Híbrido",5],[55,124,"menor",5],[55,125,"",5],[55,126,"Passiva",5],[55,127,"Sua capacidade de carga aumenta em Maestria Volume; os valores que usam o dobro do limite acompanham esse aumento. Você também pode guardar corporalmente um objeto de até 1 Volume, que continua contando na carga. Guardar e retirar seguem as manipulações normais.",5],[56,122,"Memória da Dor",5],[56,123,"Híbrido",5],[56,124,"menor",5],[56,125,"",5],[56,126,"Uma vez por cena",5],[56,127,"Uma vez por cena, depois de falhar em um TR contra um feitiço, pode marcar aquela ameaça. Receba vantagem no próximo TR contra uma nova conjuração do mesmo feitiço pelo mesmo inimigo, ainda nesta cena.\n\nO benefício acaba nessa rolagem. Não refaz a falha anterior nem melhora saídas de uma condição já aplicada.",5],[57,122,"Recomposição Precisa",5],[57,123,"Híbrido",5],[57,124,"menor",5],[57,125,"",5],[57,126,"Passiva",5],[57,127,"Por aplicação de cura recebida, pode repetir até metade da Constituição, arredondada para baixo, mínimo 1, dos dados que deram 1. Aceite os novos resultados.\n\nA repetição não cria outra aplicação de cura nem reaplica seus bônus. Uma cura sem dados não ganha dados para repetir.",5],[58,122,"Reserva Orgânica",5],[58,123,"Híbrido",5],[58,124,"menor",5],[58,125,"",5],[58,126,"Passiva",5],
      [58,127,"Transforme a cura que excederia sua vida máxima em vida temporária, até Constituição, mínimo 1, respeitando o teto geral e sem somar reservas. Isso não altera a exigência de vida para iniciar Regeneração Orgânica.",5],[59,122,"Metabolismo Flexível",5],[59,123,"Híbrido",5],[59,124,"menor",5],[59,125,"",5],[59,126,"No descanso curto",5],[59,127,"No descanso curto, pode ceder até sua maior Classe dos PE que efetivamente recuperaria para receber 3 PV por PE cedido. Não gasta PE que já possuía nem recebe os pontos cedidos junto da cura.",5],[60,122,"Ferramentas Integradas",5],[60,123,"Corpo Amaldiçoado",5],[60,124,"menor",5],[60,125,"",5],[60,126,"Uma vez por cena",5],[60,127,"Incorpore à estrutura um conjunto de ferramentas de um Ofício em que seja treinado. O conjunto não ocupa Volume e fica disponível sem sacar ou guardar. Uma vez por cena, antes de um teste desse Ofício que use as ferramentas integradas, receba vantagem.\n\nA isenção não inclui materiais, peças transportadas ou produtos. Você ainda precisa obter o conjunto; a menor não concede ferramentas gratuitas ou o treino. Instalação e troca acompanham a manutenção, sem exigir oficina fixa ou vínculo com o criador. Restrições próprias de um teste continuam valendo, como as fontes de vantagem permitidas em Criação de entidades.",5],[61,122,"Acabamento Trocável",5],[61,123,"Corpo Amaldiçoado",5],[61,124,"menor",5],[61,125,"",5],[61,126,"Uma vez por cena",5],
      [61,127,"Depois de mudar seu acabamento, escolha duas perícias entre Persuasão, Enganação, Intimidação e Atuação. Uma vez por cena, antes de um teste social de uma delas, receba vantagem. As duas compartilham o uso.\n\nDurante um descanso curto ou longo, pode fazer uma mudança visível com materiais adequados disponíveis, como roupas, tintas ou revestimentos. Ao concluir o descanso, entram em vigor a aparência e a nova escolha de perícias, sem PE ou teste. Isso não renova o uso por cena.\n\nA seleção acompanha a mudança de acabamento, não cada teste. A alteração não modifica automaticamente voz, tamanho, capacidades ou assinatura de energia, nem oferece treino ou sucesso social impossível.",5],[62,122,"Amortecimento de Queda",5],[62,123,"Corpo Amaldiçoado",5],[62,124,"menor",5],[62,125,"",5],[62,126,"Uma vez por cena",5],[62,127,"Uma vez por cena, estando consciente, use sua Reação para reduzir à metade o dano que sofreria de uma queda, arredondando para baixo depois das defesas aplicáveis.\n\nNão permite voo, planagem ou mudança do local de chegada. Um ataque que cause a queda e a queda em si são eventos distintos.",5],[63,122,"Reparo Autônomo",5],[63,123,"Corpo Amaldiçoado",5],[63,124,"menor",5],[63,125,"",5],[63,126,"Uma vez por dia",5],[63,127,"Uma vez por dia, gaste uma Ação Padrão para reparar a si mesmo, inclusive em combate. No sucesso, recupere 30% da vida máxima, arredondados para baixo. Precisa estar consciente e capaz, treinado no ofício compatível, com ferramentas e materiais acessíveis.\n\nUse o teste de Reparar, comparando sua Classe consigo mesma. Esta menor tem sua própria ação, frequência e taxa; não consome uma tentativa de um descanso curto futuro. Manutenção Precisa continua exigindo reparo durante descanso curto.",5],[64,122,"Redundância",5],[64,123,"Corpo Amaldiçoado",5],[64,124,"menor",5],[64,125,"",5],[64,126,"Uma vez por cena",5],
      [64,127,"Escolha Físico, Vigor, Intelecto ou Espírito. Uma vez por cena, quando falhar no TR escolhido, pode repetir a rolagem e deve aceitar o segundo resultado. A escolha é fixa; não exige treino nem o concede. Mantenha os modificadores e requisitos do teste.",5],[65,122,"Carcaça Grande",5],[65,123,"Corpo Amaldiçoado",5],[65,124,"menor",5],[65,125,"",5],[65,126,"Passiva",5],[65,127,"Você é da categoria de tamanho Grande, de forma passiva e permanente. Aplique as regras gerais de tamanho. Não há ativação, custo ou transformação temporária, nem bônus próprio de vida, dano, Força, carga ou alcance concedido por esta menor.",5],[66,122,"Construção Especializada",5],[66,123,"Corpo Amaldiçoado",5],[66,124,"menor",5],[66,125,"",5],[66,126,"Passiva",5],[66,127,"Receba um Talento passivo de Categoria de Efeito 1, compatível com sua rota e respeitando os requisitos. Ele representa uma função incorporada ao projeto e fica fora dos espaços conhecidos e dos cinco Talentos pagos.\n\nEscolha na criação, sem duplicação, evolução gratuita ou troca livre durante manutenção. O benefício não concede técnica inata.",5],[67,122,"Arquivo de Procedimentos",5],[67,123,"Corpo Amaldiçoado",5],[67,124,"menor",5],[67,125,"",5],[67,126,"No descanso curto",5],[67,127,"Registre três perícias ou Ofícios. Você mantém treino em um deles por vez. Durante um descanso curto ou longo, pode trocar uma vez o procedimento ativo; a mudança entra em vigor ao concluir o descanso, sem PE, teste ou material adicional apenas para selecioná-lo.\n\nA lista dos três permanece fixa. Pode trocar o procedimento no mesmo descanso em que muda o acabamento. Mantenha os requisitos de ferramentas, materiais, receitas e conhecimentos da tarefa.\n\nO treino do Arquivo não pode ser aprimorado para especialização nem servir de requisito para adquiri-la. Não soma bônus a um treino já possuído nem concede os três ao mesmo tempo. Treinos e especializações obtidos por fontes independentes conservam suas regras.",5],
      [68,122,"Núcleo Dependente",5],[68,123,"Corpo Amaldiçoado",5],[68,124,"menor",5],[68,125,"",5],[68,126,"Passiva",5],
      [
        68,127,
        "Sua estrutura depende diretamente da reserva de energia. Aumente seus PE máximos em Essência + quantidade de marcos alcançados × metade da Essência, arredondada para baixo. Conte os marcos dos níveis 6, 10, 14, 18, 22, 26 e 30.\n\nQuando Essência aumentar, recalcule todo o benefício, inclusive as parcelas anteriores. Não use Maestria nessa conta. Alterar o máximo não recupera toda a reserva; o saldo segue a regra geral aplicável à mudança.\n\nExemplo: com Essência 3 no nível 10, há dois marcos: 3 + 2 × 1 = 5 PE adicionais. Se Essência subir para 4, recalcule: 4 + 2 × 2 = 8 PE adicionais.\n\nAlma e Integridade.\n\nVocê não possui barra de Integridade. Dano de Alma que também atinja vida continua causando sua perda de vida. Você é imune ao dano exclusivo à Integridade, que não atinge vida; nenhum desses danos se converte em perda de PE. Os estágios de Integridade não se aplicam, e recuperar Integridade não recupera energia.\n\nIsso não significa ausência de alma ou imunidade a todos os efeitos que a atinjam. Em um efeito misto, resolva os demais componentes aplicáveis. Exigências de recuperar Integridade após derrota só se aplicam a quem possui essa reserva; outras causas de queda ou inconsciência continuam valendo.\n\nFalta de energia.\n\nVocê fica inativo quando não resta nenhum PE comum ou temporário. Se gastar os últimos PE numa capacidade, resolva primeiro o efeito pago e fique inativo depois.\n\nEnquanto inativo, permanece consciente, pode falar, perceber o entorno e fazer gestos simples. Seu deslocamento cai à metade. Falha automaticamente em quaisquer testes e não pode realizar outras ações, usar Reações ou Bloquear. Sua Defesa continua normal. Isso não impede inconsciência ou derrota por outros motivos.\n\nReceber pelo menos 1 PE comum ou temporário por uma fonte válida encerra imediatamente a inatividade, sem ação adicional. Não renova ações ou Reações gastas nem remove outros impedimentos. Se a energia temporária acabar ou expirar e não houver PE comuns, você fica inativo novamente.\n\nRecuperação de energia.\n\nConserve a recuperação normal por descanso, inclusive enquanto inativo: 25% dos PE máximos no curto e até o máximo no longo, com os arredondamentos e requisitos normais. Existência Artificial torna o ambiente propício, mas ainda é preciso uma pausa real e encerrar a missão para o descanso longo.\n\nO fornecedor de energia e o que cobra fazem parte da história. Esta menor não cria consumo automático, doação obrigatória por descanso ou transferência livre de PE entre personagens. Recuperar durante uma cena exige uma fonte que permita fazê-lo. Abastecimento de energia e reparo de vida são procedimentos distintos.",
        5
      ],
      [69,122,"Mente Resguardada",5],[69,123,"Corpo Amaldiçoado",5],[69,124,"menor",5],[69,125,"",5],[69,126,"Passiva",5],[69,127,"Você é imune a Enfeitiçado e Amedrontado. Ao escolher esta menor, escolha permanentemente uma contrapartida:\n\n- Vulnerabilidade a um tipo de dano Físico; ou\n\n- Vulnerabilidade a um tipo de dano Elemental e um tipo de dano Especial.\n\nEscolha tipos individuais dos grupos apresentados em Dano, não grupos inteiros. Use as regras normais de vulnerabilidade. A imunidade não se estende a dano Psíquico, todo TR Mental, ilusões ou outras condições. Você continua tendo emoções, vontade e alma.",5],[70,122,"Porte Incomum",5],[70,123,"Restrição Celestial · Sem Energia",5],[70,124,"menor",5],[70,125,"",5],[70,126,"Passiva",5],[70,127,"Seu limite normal de carga aumenta em Volume igual à Maestria. Calcule o dobro a partir do novo limite. Não aumenta Força, tamanho ou dano, nem dispensa requisitos de empunhadura e proteção. Você ainda precisa conseguir segurar e transportar o que carrega.\n\nExemplo: Força 3 e Maestria 1 dão limite de 5 + 3 + 1 = 9 Volume, com teto de 18 para o excesso permitido. As penalidades de carga continuam valendo.",5],[71,122,"Corpo Flexível",5],[71,123,"Restrição Celestial · Sem Energia",5],[71,124,"menor",5],[71,125,"",5],[71,126,"Passiva",5],[71,127,"Ao se espremer, ignore apenas o custo adicional de movimento da passagem estreita. A abertura ainda precisa comportar corpo e equipamento; penalidades de combate, terreno difícil e rastejar permanecem. Atravessar 3 m de passagem regular custa 3 m em vez de 6 m.",5],[72,122,"Mapa Mental",5],[72,123,"Restrição Celestial · Sem Energia",5],[72,124,"menor",5],[72,125,"",5],[72,126,"Passiva",5],
      [72,127,"Recorde sem teste o percurso que atravessou conscientemente: curvas, bifurcações e a ordem dos marcos percebidos. Não revela atalhos, caminhos desconhecidos, mudanças posteriores ou deslocamentos que não pôde acompanhar. A capacidade preserva trajetos difíceis sem retirar dos outros a memória cotidiana de caminhos simples.",5],[73,122,"Aprendizado Complementar",5],[73,123,"Restrição Celestial · Sem Energia",5],[73,124,"menor",5],[73,125,"",5],[73,126,"Passiva",5],[73,127,"Receba treino em uma perícia ou dois Ofícios que ainda não possua e possa aprender pela sua rota. Escolha ao adquirir a menor. Não fornece ferramentas, materiais, idiomas, treino em armas, TR ou especialização. Não libera Sentir Energia.",5],[74,122,"Assistência Técnica",5],[74,123,"Restrição Celestial · Sem Energia",5],[74,124,"menor",5],[74,125,"",5],[74,126,"Passiva",5],[74,127,"Escolha uma perícia ou Ofício em que seja treinado. Quando usar Ajudar no teste correspondente de um aliado, ele recebe bônus igual à sua Maestria, além da vantagem normal da ajuda. O aliado mantém seus próprios modificadores.\n\nAplique o bônus uma vez no total, não por dado. Uma desvantagem que cancele a vantagem de Ajudar não cancela esse bônus. Mantenha contribuição possível, ação, prazo e limite normal de um ajudante; não supre treino obrigatório, ferramenta ou sentido ausente. Não vale para seu próprio teste, ataques ou TRs.",5],[75,122,"Ferramentas Improvisadas",5],[75,123,"Restrição Celestial · Sem Energia",5],[75,124,"menor",5],[75,125,"",5],[75,126,"Passiva",5],
      [75,127,"Escolha um Ofício treinado. Nas tarefas que exigem apenas ferramentas manuais portáteis desse Ofício, pode substituir o conjunto por objetos que tenha em mãos e consiga usar fisicamente nas funções necessárias. Trate-os como ferramentas adequadas, sem penalidade apenas por serem improvisados.\n\nNão substitui ingredientes, consumíveis, instalações, fonte de calor, diagnóstico eletrônico, proteção necessária ou processos especiais. Também não fornece poderes de ferramenta amaldiçoada ou um Selo. Os objetos precisam existir e cumprir a função.",5],[76,122,"Fôlego Recuperado",5],[76,123,"Restrição Celestial · Sem Energia",5],[76,124,"menor",5],[76,125,"",5],[76,126,"No descanso curto",5],[76,127,"Ao concluir um descanso curto que permita recuperar PE, recupere PE adicionais iguais à sua maior Classe disponível, sem ultrapassar o máximo. Calcule a recuperação normal primeiro e acrescente o bônus.\n\nRecuperação expressamente proibida continua zero. A menor não cura vida, recupera Integridade ou retira Exaustão. Uma pausa contínua é um descanso, não várias recuperações. Use a Classe disponível pela progressão, não a maior Kata conhecida ou a última utilizada.",5],[77,122,"Contribuição Decisiva",5],[77,123,"Restrição Celestial · Sem Energia",5],[77,124,"menor",5],[77,125,"",5],[77,126,"Uma vez por cena",5],
      [77,127,"Uma vez por cena, depois das rolagens e antes da consequência de um teste de grupo de uma perícia em que seja treinado, se você passou, pode fazer seu sucesso contar como dois para o resultado coletivo. Não exige ação ou PE além da participação na tarefa.\n\nCada teste coletivo recebe no máximo uma aplicação, mesmo com vários portadores. Quem não a aplicou conserva seu uso. O grupo mantém o número de participantes e o limiar normal; a contagem ganha uma contribuição de sucesso. Isso não torna outro personagem bem-sucedido para consequências individuais ou transforma uma tarefa individual em teste de grupo.\n\nExemplo: cinco personagens precisam de três sucessos. Você e um aliado passam, totalizando dois. Sua contribuição passa a valer dois; com a do aliado, o grupo chega a três. Ninguém refaz a rolagem.",5],[78,122,"Reserva Condensada",5],[78,123,"Restrição Celestial · Restrição corporal",5],[78,124,"menor",5],[78,125,"",5],[78,126,"Passiva",5],[78,127,"Você aprendeu a preservar uma parcela de sua energia, reunindo aos poucos uma reserva para necessidades futuras. Ela permanece guardada até você decidir recorrer ao que acumulou.\n\nJogador e mestre definem quanto pode ser guardado em cada ocasião, quando e em quais condições o armazenamento pode ocorrer e o máximo acumulável. Registre esses limites e condições na ficha.",5],[79,122,"Reserva Excedente",5],[79,123,"Restrição Celestial · Restrição corporal",5],[79,124,"menor",5],[79,125,"",5],[79,126,"Passiva",5],[79,127,"Seus PE máximos aumentam em 2 × Essência. Atualize o acréscimo quando o atributo mudar. A recuperação desses pontos segue normalmente.",5],[80,122,"Recuperação Abundante",5],[80,123,"Restrição Celestial · Restrição corporal",5],[80,124,"menor",5],[80,125,"",5],[80,126,"No descanso curto",5],
      [80,127,"Num descanso curto em ambiente propício para sua Restrição, recupere 40% dos PE máximos, arredondados para baixo, mínimo 1, sem ultrapassar o máximo.\n\nOs cuidados continuam obrigatórios: estrutura protegida e assistência no Debilitado; apoio e atendimento no Quebradiço; os cuidados registrados no Exaurido. Reduções ou impedimentos específicos à recuperação de PE continuam valendo. Fora de ambiente propício, use a recuperação normal. A redução de cura do Exaurido afeta vida, não esses PE.",5],[81,122,"Sobrecarga Deliberada",5],[81,123,"Restrição Celestial · Restrição corporal",5],[81,124,"menor",5],[81,125,"",5],[81,126,"Uma vez por cena",5],[81,127,"Uma vez por cena, antes das rolagens de um feitiço comum de Classe 1 ou maior, pague PE adicionais iguais à metade do custo-base, arredondada para cima, e escolha vantagem em uma rolagem de ataque ou desvantagem para um alvo em um TR da aplicação inicial.\n\nEscolha antes do dado. O custo-base é o da Classe utilizada, antes de descontos e acréscimos: base 9 PE cobra 5 PE adicionais, além do custo normal do feitiço. Só aquela rolagem recebe o benefício; não alcança outros ataques, alvos ou TRs posteriores para sair de uma condição. Não vale para Manejos ou Máximas.",5],[82,122,"Leitura de Reservas",5],[82,123,"Restrição Celestial · Restrição corporal",5],[82,124,"menor",5],[82,125,"",5],[82,126,"Passiva",5],[82,127,"Ao passar num exame de fluxo com Sentir Energia, descubra também os PE atuais e máximos do alvo naquele momento. Mantenha o procedimento normal; esta é uma informação adicional do exame.",5],[83,122,"Último Fôlego de Energia",5],[83,123,"Restrição Celestial · Restrição corporal",5],[83,124,"menor",5],[83,125,"",5],[83,126,"Uma vez por descanso longo",5],
      [83,127,"Uma vez por descanso longo, após pagar um feitiço que deixe sua energia em zero, receba PE temporários iguais a 2 × sua maior Classe, respeitando o teto normal. Duram até o fim do próximo turno e não podem ser armazenados na Reserva Condensada.",5],[84,122,"Percepção Estendida",5],[84,123,"Restrição Celestial · Restrição corporal",5],[84,124,"menor",5],[84,125,"",5],[84,126,"Passiva",5],[84,127,"O alcance de Vasculhar com Sentir Energia aumenta de 18 m para 36 m, permanentemente. Mantenha ação, testes e obstáculos normais. Isso não aumenta outros sentidos, procedimentos ou alcances de feitiços.",5],[85,122,"Prática Cotidiana",5],[85,123,"Restrição Celestial · Restrição corporal",5],[85,124,"menor",5],[85,125,"",5],[85,126,"Passiva",5],[85,127,"Aprenda dois feitiços adicionais de Classe 0, compatíveis com sua técnica, em quaisquer Formas normalmente permitidas nessa Classe. Eles ficam além da quantidade normal conhecida e seguem as demais regras dessas aplicações.\n\nA escolha não se limita a Apoio ou Efeito. Esses feitiços não viram espaços comuns para Talentos ou invocações.",5]
    ]
  }
];

