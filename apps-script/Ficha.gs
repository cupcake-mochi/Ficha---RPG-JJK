,"",8],[14,4,8.0,6],[14,8,"Fisgada",7],[14,16,"prende à distância. Ela alcança, engancha, e quem ia fugir para de conseguir",8],[14,47,"",8],[14,48,"",8],[14,49,"",8],[14,50,"",8],[14,51,"",8],[15,4,8.0,6],[15,8,"Emboscada",7],[15,16,"surge do chão, fora do alcance de visão",8],[15,47,"",8],[15,48,"",8],[15,49,"",8],[15,50,"",8],[15,51,"",8],[16,4,8.0,6],[16,8,"Jorro",7],[16,16,"ataca em linha ou em área",8],[16,47,"",8],[16,48,"",8],[16,49,"",8],[16,50,"",8],[16,51,"",8],[17,4,8.0,6],[17,8,"Graúdo",7],[17,16,"ocupa espaço maior e barra passagem",8],[17,47,"",8],[17,48,"",8],[17,49,"",8],[17,50,"",8],[17,51,"",8],[18,4,8.0,6],[18,8,"Remoto",7],[18,16,"funciona além dos 18 metros da amarra. Dentro da cena, para qualquer um; fora da cena, com requisito",8],[18,47,"",8],[18,48,"",8],[18,49,"",8],[18,50,"",8],[18,51,"",8],[21,4,"COMANDO",2],[21,21,"o que ela faz quando você gasta a Ação Padrão comandando.",3],[21,47,"",3],[21,48,"",3],[21,49,"",3],[21,50,"",3],[21,51,"",3],[22,4,"PONTOS",4],[22,8,"NOME",5],[22,16,"O QUE FAZ",5],[22,47,"",5],[22,48,"",5],[22,49,"",5],[22,50,"",5],[22,51,"",5],[23,4,0.0,6],[23,8,"Investir",7],[23,16,"o ataque. Toda invocação tem",8],[23,47,"",8],[23,48,"",8],[23,49,"",8],[23,50,"",8],[23,51,"",8],[24,4,4.0,6],[24,8,"Agarrar",7],[24,16,"prende o alvo",8],[24,47,"",8],[24,48,"",8],[24,49,"",8],[24,50,"",8],[24,51,"",8],[25,4,4.0,6],[25,8,"Arrastar",7],[25,16,"move o alvo, ou se move levando ele. Tira alguém de cima de uma beirada, ou põe",8],[25,47,"",8],[25,48,"",8],[25,49,"",8],[25,50,"",8],[25,51,"",8],[26,4,4.0,6],[26,8,"Buscar",7],[26,16,"pega um objeto, ou rastreia de forma ativa",8],[26,47,"",8],[26,48,"",8],[26,49,"",8],[26,50,"",8],[26,51,"",8],[27,4,4.0,6],[27,8,"Cavar",7],[27,16,"abre buraco, desenterra, revira o terreno. Faz rota onde não havia rota",8],[27,47,"",8],[27,48,"",8],[27,49,"",8],[27,50,"",8],[27,51,"",8],[28,4,8.0,6],[28,8,"Interpor",7],[28,16,"se põe entre você e o golpe. O corpo dela recebe o que ia em você",8],[28,47,"",8],[28,48,"",8],[28,49,"",8],[28,50,"",8],[28,51,"",8],[29,4,8.0,6],[29,8,"Chamariz",7],[29,16,"o alvo tem de vir para cima dela. Você escolhe em quem a coisa está prestando atenção",8],[29,47,"",8],[29,48,"",8],[29,49,"",8],[29,50,"",8],[29,51,"",8],[32,4,"INVENTAR O SEU",2],[32,21,"escreva o efeito, ache na régua o preço, e leve para o mestre aprovar",3],[32,47,"",3],[32,48,"",3],[32,49,"",3],[32,50,"",3],[32,51,"",3],[33,4,"régua de TRAÇO",5],[33,47,"",5],[33,48,"",5],[33,49,"",5],[33,50,"",5],[33,51,"",5],[34,4,2.0,6],[34,8,"muda como ela anda, e só ela",8],[34,47,"",8],[34,48,"",8],[34,49,"",8],[34,50,"",8],[34,51,"",8],[35,4,3.0,6],[35,8,"muda o que ela comunica",8],[35,47,"",8],[35,48,"",8],[35,49,"",8],[35,50,"",8],[35,51,"",8],[36,4,5.0,6],[36,8,"muda o que ela percebe",8],[36,47,"",8],[36,48,"",8],[36,49,"",8],[36,50,"",8],[36,51,"",8],[37,4,7.0,6],[37,8,"muda que espaço ela ocupa, a um passo de mexer no tabuleiro",8],[37,47,"",8],[37,48,"",8],[37,49,"",8],[37,50,"",8],[37,51,"",8],[38,4,8.0,6],[38,8,"encosta em outra criatura ou no ambiente: carrega, prende, empurra, barra, alcança além do alcance, aparece onde não dava",8],[38,47,"",8],[38,48,"",8],[38,49,"",8],[38,50,"",8],[38,51,"",8],[39,36,"",9],[39,37,"",9],[39,38,"",9],[39,39,"",9],[39,40,"",9],[39,41,"",9],[39,42,"",9],[39,43,"",9],[39,44,"",9],[39,45,"",9],[39,46,"",9],[39,47,"",9],[39,48,"",9],[39,49,"",9],[39,50,"",9],[39,51,"",9],[40,4,"régua de COMANDO",5],[40,47,"",5],[40,48,"",5],[40,49,"",5],[40,50,"",5],[40,51,"",5],[41,4,0.0,6],[41,8,"é o ataque",8],[41,47,"",8],[41,48,"",8],[41,49,"",8],[41,50,"",8],[41,51,"",8],[42,4,4.0,6],[42,8,"faz uma coisa com um alvo ou um objeto",8],[42,47,"",8],[42,48,"",8],[42,49,"",8],[42,50,"",8],[42,51,"",8],[43,4,8.0,6],[43,8,"protege você, ou nega a ação de outro",8],[43,47,"",8],[43,48,"",8],[43,49,"",8],[43,50,"",8],[43,51,"",8],[45,4,"O QUE O ORÇAMENTO NÃO COMPRA",10],[45,47,"",10],[45,48,"",10],[45,49,"",10],[45,50,"",10],[45,51,"",10],[46,4,"dado de dano",7],[46,18,"o teto de uma Rotina já governa a saída. Um Traço que dê +1d6 não existe",3],[46,47,"",3],[46,48,"",3],[46,49,"",3],[46,50,"",3],[46,51,"",3],[47,4,"qualquer coisa que cresça com refino",7],[47,18,"refino cresce muito mais rápido que a ficha dela, e ela passaria de você",3],[47,47,"",3],[47,48,"",3],[47,49,"",3],[47,50,"",3],[47,51,"",3],[48,4,"atributo",7],[48,18,"os cinco já saem do arranjo dela, e comprar de novo é pagar duas vezes",3],[48,47,"",3],[48,48,"",3],[48,49,"",3],[48,50,"",3],[48,51,"",3],[49,4,"Defesa, acerto ou vida direto",7],[49,18,"os três saem dos atributos dela",3],[49,47,"",3],[49,48,"",3],[49,49,"",3],[49,50,"",3],[49,51,"",3]],"estilos":[["Oswald",16.0,"#E8DCD4",false,"left","middle",0,false,false],["Courier New",8.0,"#998BA9",false,"right","middle",0,false,false],["Oswald",12.0,"#E8DCD4",false,"left","middle",0,false,false],["Roboto",9.0,"#998BA9",false,"left","middle",0,false,false],["Oswald",8.0,"#E8DCD4",false,"center","middle",0,false,false],["Oswald",8.0,"#E8DCD4",false,"left","middle",0,false,false],["Oswald",11.0,"#E8DCD4",false,"center","middle",0,false,false],["Castoro",10.0,"#E8DCD4",false,"left","middle",0,false,false],["Roboto",9.0,"#F4F1F7",false,"left","middle",0,false,false],["Roboto",null,null,false,"left","bottom",0,false,false],["Oswald",8.0,"#D89B3A",false,"left","middle",0,false,false]],"fundos":[[1,3,4,"#3D2E78"],[1,31,32,"#3D2E78"],[1,47,51,"#3D2E78"],[2,3,3,"#3D2E78"],[2,31,31,"#3D2E78"],[2,47,51,"#3D2E78"],[4,4,4,"#211940"],[4,21,21,"#211940"],[4,47,51,"#211940"],[5,4,4,"#3D2E78"],[5,8,8,"#3D2E78"],[5,16,16,"#3D2E78"],[5,47,51,"#3D2E78"],[6,4,4,"#1E1733"],[6,8,8,"#1E1733"],[6,16,16,"#1E1733"],[6,47,51,"#1E1733"],[7,4,4,"#3D2E78"],[7,8,8,"#3D2E78"],[7,16,16,"#3D2E78"],[7,47,51,"#3D2E78"],[8,4,4,"#1E1733"],[8,8,8,"#1E1733"],[8,16,16,"#1E1733"],[8,47,51,"#1E1733"],[9,4,4,"#3D2E78"],[9,8,8,"#3D2E78"],[9,16,16,"#3D2E78"],[9,47,51,"#3D2E78"],[10,4,4,"#1E1733"],[10,8,8,"#1E1733"],[10,16,16,"#1E1733"]