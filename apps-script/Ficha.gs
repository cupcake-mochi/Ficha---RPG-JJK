UMN(FICHA!AK63),4)",5],[77,53,"trocou por arma",5],[77,54,"=ADDRESS(ROW(FICHA!AK65),COLUMN(FICHA!AK65),4)",5],[78,53,"grupo de arma da trilha",5],[78,54,"=ADDRESS(ROW(FICHA!AK69),COLUMN(FICHA!AK69),4)",5]],"estilos":[["Oswald",9.0,"#998BA9",false,"left","middle",0,false,false],["Roboto",12.0,"#F4F1F7",true,"left","middle",0,false,false],["Roboto",9.0,"#998BA9",false,"left","middle",0,false,false],["Roboto",11.0,"#F4F1F7",false,"left","middle",0,false,false],["Oswald",9.0,"#998BA9",false,"center","middle",0,false,false],["Roboto",12.0,"#F4F1F7",false,"left","middle",0,false,false],["Roboto",9.0,"#998BA9",false,"center","middle",0,false,false],["Roboto",12.0,"#F4F1F7",false,"center","middle",0,false,false]],"fundos":[],"bordas":[],"merges":[],"dv":[],"imgs":[],"alturas":{"1":23,"4":23,"5":23,"6":23,"7":23,"8":23,"9":23,"10":23,"11":23,"12":23,"13":23,"14":23,"15":23,"16":23,"17":23,"18":23,"19":23,"20":23,"21":23,"22":23,"23":23,"24":23,"25":23,"26":23,"27":23,"28":23,"29":23,"30":23,"31":23,"32":23,"33":23,"34":23,"35":23,"36":23,"37":23,"38":23,"39":23,"40":23,"41":23,"42":23,"43":23,"44":23,"45":23,"46":23,"47":23,"48":23,"49":23,"50":23,"51":23,"52":23,"53":23,"54":23,"55":23,"56":23,"57":23,"58":23,"59":23,"60":23,"61":23,"62":23,"63":23,"64":23,"65":23,"66":23,"67":23,"68":23,"69":23},"largs":[],"oculta":true,"caixas":[]},{"nome":"GLOSSÁRIO","cols":34,"rows":59,"larg":39,"padrao":["Roboto",12,"#F4F1F7"],"fundo_base":"#120F1D","vals":[[1,2,"O GLOSSÁRIO — o que cada coisa da ficha quer dizer",0],[1,23,"capítulo 1 · 2 · 13",1],[4,2,"ATRIBUTOS",2],[4,13,"O número é o modificador. Escala de 0 a 6, sem tabela de conversão.",3],[5,5,"ATRIBUTO",4],[5,11,"O QUE GOVERNA",4],[6,2,"",5],[6,5,"Força",6],[6,11,"Quanto o seu corpo aguenta e impõe, na base do músculo. Governa: ataque corpo a corpo, agarrar, quebrar, carregar",7],[7,2,"",5],[7,5,"Destreza",6],[7,11,"Sua velocidade e precisão — o corpo respondendo rápido, a mira certa. Governa: ataque à distância, Defesa, iniciativa, furtividade",7],[8,2,"",5],[8,5,"Constituição",6],[8,11,"Sua resistência bruta a dano e a desgaste. Governa: pontos de vida",7],[9,2,"",5],[9,5,"Inteligência",6],[9,11,"O que você sabe e deduz — o raciocínio frio. Governa: conhecimento, investigação, reconhecer uma técnica pelo catálogo",7],[10,2,"",5],[10,5,"Essência",6],[10,11,"Sua sensibilidade à energia amaldiçoada e às pessoas — o que você sente, não o que você calcula. Governa: perceber energia amaldiçoada, trato social, hierarquia, negociar Pactos",7],[12,2,"PERÍCIAS",2],[12,13,"9 de 23 na criação — ou 10, trocando os dois ofícios da Origem.",3],[13,2,"ATRIBUTO",8],[13,5,"NOME",4],[13,11,"O QUE FAZ",4],[14,2,"Acrobacia",5],[14,5,"Destreza",6],[14,11,"Mede seu equilíbrio e o controle fino do próprio corpo em movimento. Exemplo: equilíbrio, cair sem se machucar, escapar de um agarrão, passar por espaço 3 apertado.",7],[15,2,"Atletismo",5],[15,5,"Força",6],[15,11,"Mede seu corpo em esforço físico direto. Exemplo: correr, escalar, nadar, saltar, carregar alguém que não consegue andar.",7],[16,2,"Atuação",5],[16,5,"Essência",6],[16,11,"Mede sua capacidade de performar ou sustentar um papel diante de alguém. Exemplo: representar, cantar, tocar para uma plateia, sustentar um personagem que não é você.",7],[17,2,"Enganação",5],[17,5,"Essência",6],[17,11,"Mede sua capacidade de mentir de um jeito convincente. Exemplo: mentir, blefar, se passar por outro.",7],[18,2,"Furtividade",5],[18,5,"Destreza",6],[18,11,"Mede sua capacidade de passar despercebido. Exemplo: mover-se sem ser visto nem ouvido.",7],[19,2,"Hierarquia",5],[19,5,"Inteligência",6],[19,11,"Mede seu conhecimento da política entre clãs e feiticeiros — quem manda em quem. Exemplo: os clãs, a política, quem manda em quem e quem deve o quê a quem. Diz o que você pode pedir, a quem, e o que vai custar.",7],[20,2,"História",5],[20,5,"Inteligência",6],[20,11,"Mede sua memória do que já aconteceu e de quem estava lá. Exemplo: o que aconteceu e quem estava lá, no mundo comum e no registro das famílias.",7],[21,2,"Intimidação",5],[21,5,"Essência",6],[21,11,"Mede sua capacidade de fazer alguém recuar pela ameaça ou pela presença. Exemplo: ameaçar, dominar pela presença, fazer alguém recuar.",7],[22,2,"Intuição",5],[22,5,"Inteligência",6],[22,11,"Mede sua leitura racional do comportamento alheio — dedução sobre gente. Exemplo: ler a pessoa pelo que ela faz: a inconsistência na história, o detalhe que não fecha, a motivação atrás do pedido. É dedução sobre gente, e por isso é Inteligência.",7],[23,2,"Investigação",5],[23,5,"Inteligência",6],[23,11,"Mede sua capacidade de vasculhar um lugar e ligar pistas soltas. Exemplo: vasculhar, deduzir, ligar duas pistas que ninguém tinha ligado.",7],[24,2,"Lidar com Animais",5],[24,5,"Inteligência",6],[24,11,"Mede sua capacidade de acalmar, montar ou conduzir um animal. Exemplo: acalmar, montar, conduzir, mandar num bicho. Vale para o que não é bicho mas se comporta como um.",7],[25,2,"Medicina",5],[25,5,"Inteligência",6],[25,11,"Mede seu conhecimento teórico de ferimento, veneno e doença. Exemplo: ferimento, veneno, doença, corpo. É o saber; a prática de campo é o ofício Herbalismo .",7],[26,2,"Natureza",5],[26,5,"Inteligência",6],[26,11,"Mede seu conhecimento do mundo natural — planta, bicho, clima, terreno. Exemplo: planta, bicho, clima, terreno. O que é o quê, o que é venenoso, quando a chuva vem.",7],[27,2,"Ocultismo",5],[27,5,"Inteligência",6],[27,11,"Mede seu conhecimento técnico de maldições e do funcionamento da energia amaldiçoada. Exemplo: maldições, técnicas conhecidas, barreiras, o funcionamento da energia amaldiçoada. O lado técnico.",7],[28,2,"Percepção",5],[28,5,"Essência",6],[28,11,"Mede sua atenção ao que os cinco sentidos comuns captam — o lado mundano. Exemplo: notar o mundano: som, cheiro, movimento, a coisa que está fora do lugar, a pessoa suando frio.",7],[29,2,"Persuasão",5],[29,5,"Essência",6],[29,11,"Mede sua capacidade de convencer alguém a fazer o que você quer porque quer. Exemplo: convencer, negociar, conseguir que façam o que você quer porque querem.",7],[30,2,"Pontaria",5],[30,5,"Destreza",6],[30,11,"Mede sua precisão ao mirar num alvo específico, fora de uma rolagem de ataque. Exemplo: acertar o que é pequeno, o que está longe ou o que se mexe, fora de uma rolagem de ataque.",7],[31,2,"Prestidigitação",5],[31,5,"Destreza",6],[31,11,"Mede a destreza manual fina — mão rápida, gesto discreto. Exemplo: mão rápida: esconder um objeto, tirar do bolso alheio, trocar uma coisa por outra na frente de quem está olhando.",7],[32,2,"Provocar",5],[32,5,"Essência",6],[32,11,"Mede sua capacidade de tirar alguém do sério e puxá-lo pra cima de você — o oposto de Intimidação. Exemplo: tirar alguém do sério, fazer perder a linha, forçar a vir para cima de você. É o oposto de Intimidação : uma faz recuar, a outra faz avançar.",7],[33,2,"Religião",5],[33,5,"Inteligência",6],[33,11,"Mede seu conhecimento do lado sagrado e ritual do jujutsu. Exemplo: xintoísmo, budismo, exorcismo, templo, ritual, o que os selos querem dizer. O lado sagrado, que é de onde o jujutsu veio antes de virar instituição.",7],[34,2,"Sentir Energia",5],[34,5,"Essência",6],[34,11,"Mede sua sensibilidade direta à energia amaldiçoada. Exemplo: perceber energia amaldiçoada. Notar o feiticeiro escondido, medir o tamanho de uma maldição antes de encostar nela, sacar que alguém está prestes a conjurar.",7],[35,2,"Sobrevivência",5],[35,5,"Inteligência",6],[35,11,"Mede sua capacidade de aguentar e se orientar num ambiente hostil. Exemplo: aguentar o ambiente, achar água e abrigo, se orientar, e seguir um rastro, seja pegada ou resíduo de energia.",7],[36,2,"Tecnologia",5],[36,5,"Inteligência",6],[36,11,"Mede seu domínio de equipamento e sistema moderno. Exemplo: computador, câmera, rede, equipamento moderno.",7],[38,2,"OFÍCIOS",2],[38,13,"2 de 11 na criação. O atributo é do mestre, na hora — não é fixo.",3],[39,5,"NOME",4],[39,11,"O QUE FAZ",4],[40,2,"",5],[40,5,"Alfaiate",6],[40,11,"Mede sua capacidade de cortar, costurar e remendar tecido. Exemplo: tecido, corte, remendo. O uniforme que aguenta energia amaldiçoada sai daqui, e o traje sob medida também.",7],[41,2,"",5],[41,5,"Arrombamento",6],[41,11,"Mede sua capacidade de vencer uma trava sem ter a chave. Exemplo: tranca, alarme, cofre, janela que não devia abrir.",7],[42,2,"",5],[42,5,"Burocracia",6],[42,11,"Mede seu domínio da máquina administrativa jujutsu por dentro. Exemplo: a máquina jujutsu por dentro: relatório, requisição, quem assina o quê, como se pede uma janela e como se encobre o que não devia ter sido visto.",7],[43,2,"",5],[43,5,"Caligrafia",6],[43,11,"Mede sua capacidade de produzir documento escrito, oficial ou falsificado. Exemplo: talismã, papel de barreira, documento oficial. E documento oficial que não é oficial.",7],[44,2,"",5],[44,5,"Condução",6],[44,11,"Mede sua capacidade de operar um veículo. Exemplo: carro, moto, van, o que estiver na garagem.",7],[45,2,"",5],[45,5,"Culinária",6],[45,11,"Mede sua capacidade de cozinhar de verdade. Exemplo: cozinhar de verdade, para gente ou para o que aceitar comida.",7],[46,2,"",5],[46,5,"Entalhador",6],[46,11,"Mede sua capacidade de moldar madeira, pedra ou osso. Exemplo: madeira, pedra, osso. Fazer o corpo que vai receber alguma coisa.",7],[47,2,"",5],[47,5,"Forja",6],[47,11,"Mede sua capacidade de fabricar, afiar e manter arma e ferramenta. Exemplo: fazer, afiar e manter arma, e cuidar de ferramenta amaldiçoada sem estragar o que tem dentro.",7],[48,2,"",5],[48,5,"Herbalismo",6],[48,11,"Mede seu conhecimento prático de planta, aplicado a cura e a veneno. Exemplo: planta que cura, planta que mata, chá, unguento, e o que dá para fazer no mato quando não tem hospital.",7],[49,2,"",5],[49,5,"Instrumento",6],[49,11,"Mede sua capacidade de tocar um instrumento musical. Exemplo: um instrumento, escolhido no treino.",7],[50,2,"",5],[50,5,"Jogatina",6],[50,11,"Mede sua capacidade de jogar um jogo de aposta e ler quem está na mesa. Exemplo: carta, dado, aposta, e ler a mesa enquanto joga.",7],[52,2,"CONCEITOS",2],[53,5,"TERMO",4],[53,11,"O QUE SIGNIFICA",4],[54,2,"",5],[54,5,"Treino",6],[54,11,"Ter a perícia ou o ofício marcado na ficha. O mestre põe uma CD; com Destreza 3 e maestria 1, uma Furtividade treinada rola d20 + 4, sem treino d20 + 3 (capítulo 2).",7],[55,2,"",5],[55,5,"Maestria",6],[55,11,"O bônus que mede o tempo de estrada do personagem: começa em 1 e sobe um ponto a cada oito níveis. Entra em toda rolagem de ataque, na CD dos seus feitiços, e no que você treinou (capítulo 1).",7],[56,2,"",5],[56,5,"Refino",6],[56,11,"O eixo de controle da ficha: é o refino que compra as suas Aptidões. Poder é quanto você tem — Refino é quanto você não desperdiça (capítulo 13).",7]],"estilos":[["Oswald",16.0,"#E8DCD4",false,"left","middle",0,false,false],["Courier New",8.0,"#998BA9",false,"right","middle",0,false,false],["Oswald",12.0,"#E8DCD4",false,"left","middle",0,false,false],["Roboto",9.0,"#998BA9",false,"left","middle",0,false,false],["Oswald",8.0,"#E8DCD4",false,"left","middle",0,false,false],["Oswald",11.0,"#E8DCD4",false,"center","middle",0,false,true],["Castoro",10.0,"#E8DCD4",false,"left","middle",0,false,true],["Roboto",9.0,"#F4F1F7",false,"left","middle",0,false,true],["Oswald",8.0,"#E8DCD4",false,"center","middle",0,false,false]],"fundos":[[1,2,2,"#3D2E78"],[1,23,23,"#3D2E78"],[4,2,2,"#211940"],[4,13,13,"#211940"],[5,5,5,"#3D2E78"],[5,11,11,"#3D2E78"],[6,2,2,"#1E1733"],[6,5,5,"#1E1733"],[6,11,11,"#1E1733"],[7,2,2,"#3D2E78"],[7,5,5,"#3D2E78"],[7,11,11,"#3D2E78"],[8,2,2,"#1E1733"],[8,5,5,"#1E1733"],[8,11,11,"#1E1733"],[9,2,2,"#3D2E78"],[9,5,5,"#3D2E78"],[9,11,11,"#3D2E78"],[10,2,2,"#1E1733"],[10,5,5,"#1E1733"],[10,11,11,"#1E1733"],[12,2,2,"#211940"],[12,13,13,"#211940"],[13,2,2,"#3D2E78"],[13,5,5,"#3D2E78"],[13,11,11,"#3D2E78"],[14,2,2,"#1E1733"],[14,5,5,"#1E1733"],[14,11,11,"#1E1733"],[15,2,2,"#3D2E78"],[15,5,5,"#3D2E78"],[15,11,11,"#3D2E78"],[16,2,2,"#1E1733"],[16,5,5,"#1E1733