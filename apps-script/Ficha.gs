      [27,86,"Você possui visão às cegas a até 1,5 m × metade da Lapidação, arredondada para baixo. Percebe criaturas e objetos nessa área por som e movimento, mesmo sem usar os olhos. Um obstáculo sólido bloqueia essa percepção. Vulto não revela o interior de uma sala fechada. Se a cena impedir tanto som quanto sinais de movimento de chegarem até você, esses sinais deixam de fornecer percepção. Com Lapidação 4 ou 5, o alcance é 3 m. Com Lapidação 10, é 7,5 m. Fora dessa distância, use seus outros sentidos normalmente. A percepção não altera o alcance de seus ataques ou Katas.",2],[27,88,1,1],[27,89,0,1],[27,90,0,1],[27,91,"Você possui visão às cegas a até 1,5 m × metade da Lapidação, arredondada para baixo.",2],[27,127,"Feitiço 26",2],[27,128,0,1],[27,129,26,1],[27,130,"=MAX(1,MIN(7,N('FICHA AMALDIÇOADA'!$J$223)))",1],[27,131,"='FICHA AMALDIÇOADA'!$K$223&\"\"",1],[27,132,"='FICHA AMALDIÇOADA'!$J$230&\"\"",1],[27,133,"='FICHA AMALDIÇOADA'!$K$232&\"\"",1],[27,134,"='FICHA AMALDIÇOADA'!$K$233&\"\"",1],[27,135,"='FICHA AMALDIÇOADA'!$K$234&\"\"",1],[27,136,"='FICHA AMALDIÇOADA'!$K$235&\"\"",1],[27,137,"='FICHA AMALDIÇOADA'!$K$236&\"\"",1],[27,138,"='FICHA AMALDIÇOADA'!$K$237&\"\"",1],[27,215,"='FICHA AMALDIÇOADA'!$J$225&\"\"",1],[27,218,"aptidões compráveis",2],[27,219,"=MAX(0,N(DADOS!$AK$36)-2)",1],[27,266,26,1],[27,267,"=IFERROR(MATCH(26,$HH$2:$HH$37,0),0)",1],[27,305,"G46",2],[27,306,"=INDEX(DADOS_AM!$P$2:$W$8,DADOS_AM!$HK$30,3)",1],[28,41,"Onda · classes 6 e 7",2],[28,42,"Raio 4,5 m, em você",2],[28,43,"Raio 6 m, em você",2],[28,44,"Raio 9 m, em você",2],[28,45,"Raio 15 m, em você",2],[28,46,"Raio 15 m, em você",2],[28,47,"Raio 15 m, em você",2],[28,48,"",2],[28,49,"",2],[28,50,"",2],[28,51,"",2],[28,52,"",2],[28,53,"",2],[28,55,"Agarrado",2],[28,56,"Controle",2],[28,57,1,1],[28,60,1,1],[28,63,1,1],[28,82,"Esteio",2],[28,83,"Lapidação 7",2],[28,84,3,1],[28,85,"—",2],
      [28,86,"Ao adquirir a Bênção, escolha um TR: Físico, Vigor, Intelecto ou Espírito. O menor resultado do d20 nesse TR passa a ser sua Lapidação, limitada ao atributo do TR +2. No Físico, use Força ou Destreza conforme a escolha fixa da sua ficha. Vigor usa Constituição, Intelecto usa Inteligência e Espírito usa Essência. Some os modificadores normais depois de aplicar o piso. O piso não modifica o número efetivamente rolado para uma regra que exija um resultado natural. Com Lapidação 7 e atributo 4, o piso é 6. Com Lapidação 10 e atributo 6, é 8. Um resultado maior permanece como foi rolado.",2],[28,88,1,1],[28,89,0,1],[28,90,0,1],[28,91,"Ao adquirir a Bênção, escolha um TR: Físico, Vigor, Intelecto ou Espírito.",2],[28,127,"Feitiço 27",2],[28,128,0,1],[28,129,27,1],[28,130,"=MAX(1,MIN(7,N('FICHA AMALDIÇOADA'!$P$223)))",1],[28,131,"='FICHA AMALDIÇOADA'!$Q$223&\"\"",1],[28,132,"='FICHA AMALDIÇOADA'!$P$230&\"\"",1],[28,133,"='FICHA AMALDIÇOADA'!$Q$232&\"\"",1],[28,134,"='FICHA AMALDIÇOADA'!$Q$233&\"\"",1],[28,135,"='FICHA AMALDIÇOADA'!$Q$234&\"\"",1],[28,136,"='FICHA AMALDIÇOADA'!$Q$235&\"\"",1],[28,137,"='FICHA AMALDIÇOADA'!$Q$236&\"\"",1],[28,138,"='FICHA AMALDIÇOADA'!$Q$237&\"\"",1],[28,215,"='FICHA AMALDIÇOADA'!$P$225&\"\"",1],[28,218,"pactos permanentes",2],[28,219,"=IF('FICHA AMALDIÇOADA'!$L$518=\"Permanente\",1,0)+IF('FICHA AMALDIÇOADA'!$L$528=\"Permanente\",1,0)+IF('FICHA AMALDIÇOADA'!$L$538=\"Permanente\",1,0)",1],[28,266,27,1],[28,267,"=IFERROR(MATCH(27,$HH$2:$HH$37,0),0)",1],[28,305,"J46",2],[28,306,"=INDEX(DADOS_AM!$P$2:$W$8,DADOS_AM!$HK$30,4)",1],[29,41,"Efeito · classe 0",2],[29,42,"Fora de combate",2],[29,43,"Fora de combate",2],[29,44,"Fora de combate",2],[29,45,"Fora de combate",2],[29,46,"Fora de combate",2],[29,47,"Fora de combate",2],[29,48,"",2],[29,49,"",2],[29,50,"",2],[29,51,"",2],[29,52,"",2],[29,53,"",2],[29,55,"Desarmado",2],[29,56,"Controle",2],[29,57,1,1],[29,60,1,1],[29,63,1,1],[29,82,"Antecipar",2],[29,83,"Lapidação 4 e Inteligência