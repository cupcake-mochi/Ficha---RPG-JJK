38":20,"39":20,"41":20,"44":20,"47":20,"52":20,"53":20,"54":20,"55":20,"57":20,"60":20,"61":20,"63":20,"66":20,"69":20,"71":20,"72":20,"74":20,"77":20,"78":20,"92":20,"94":20,"95":20,"97":20,"100":20,"101":20,"102":20,"103":20,"104":20,"106":20,"112":20,"114":20,"117":20,"118":20,"119":20,"120":20},"largs":[],"oculta":false,"caixas":[]},{"nome":"CATÁLOGO","cols":51,"rows":66,"larg":35,"vals":[[1,4,"O CATÁLOGO — o que dá para comprar",1],[1,32,"capítulo 16",2],[4,4,"TRAÇO",3],[4,21,"o corpo dela. Vale sempre, sem gastar ação.",4],[5,4,"PONTOS",5],[5,8,"NOME",6],[5,16,"O QUE FAZ",6],[6,4,2.0,7],[6,8,"Escalada",8],[6,16,"sobe parede e teto sem teste",9],[7,4,2.0,7],[7,8,"Nado",8],[7,16,"move na água sem penalidade. Rio, cisterna, tanque alagado de estação",9],[8,4,3.0,7],[8,8,"Fala",8],[8,16,"ela fala, e dá para conversar com ela",9],[9,4,5.0,7],[9,8,"Faro",8],[9,16,"rastreia por cheiro e por energia. Pega rastro velho de horas",9],[10,4,5.0,7],[10,8,"Vigia",8],[10,16,"o que ela vê e ouve, você vê e ouve também",9],[11,4,7.0,7],[11,8,"Miúdo",8],[11,16,"ocupa espaço menor e passa por vão. Duto, grade de bueiro, folga embaixo da porta",9],[12,4,8.0,7],[12,8,"Voo",8],[12,16,"o deslocamento dela passa a ser de voo também",9],[13,4,8.0,7],[13,8,"Montaria",8],[13,16,"carrega uma pessoa ou mais, dependendo do tamanho",9],[14,4,8.0,7],[14,8,"Fisgada",8],[14,16,"prende à distância. Ela alcança, engancha, e quem ia fugir para de conseguir",9],[15,4,8.0,7],[15,8,"Emboscada",8],[15,16,"surge do chão, fora do alcance de visão",9],[16,4,8.0,7],[16,8,"Jorro",8],[16,16,"ataca em linha ou em área",9],[17,4,8.0,7],[17,8,"Graúdo",8],[17,16,"ocupa espaço maior e barra passagem",9],[18,4,8.0,7],[18,8,"Remoto",8],[18,16,"funciona além dos 18 metros da amarra. Dentro da cena, para qualquer um; fora da cena, com requisito",9],[21,4,"COMANDO",3],[21,21,"o que ela faz quando você gasta a Ação Padrão comandando.",4],[22,4,"PONTOS",5],[22,8,"NOME",6],[22,16,"O QUE FAZ",6],[23,4,0.0,7],[23,8,"Investir",8],[23,16,"o ataque. Toda invocação tem",9],[24,4,4.0,7],[24,8,"Agarrar",8],[24,16,"prende o alvo",9],[25,4,4.0,7],[25,8,"Arrastar",8],[25,16,"move o alvo, ou se move levando ele. Tira alguém de cima de uma beirada, ou põe",9],[26,4,4.0,7],[26,8,"Buscar",8],[26,16,"pega um objeto, ou rastreia de forma ativa",9],[27,4,4.0,7],[27,8,"Cavar",8],[27,16,"abre buraco, desenterra, revira o terreno. Faz rota onde não havia rota",9],[28,4,8.0,7],[28,8,"Interpor",8],[28,16,"se põe entre você e o golpe. O corpo dela recebe o que ia em você",9],[29,4,8.0,7],[29,8,"Chamariz",8],[29,16,"o alvo tem de vir para cima dela. Você escolhe em quem a coisa está prestando atenção",9],[32,4,"INVENTAR O SEU",3],[32,21,"escreva o efeito, ache na régua o preço, e leve para o mestre aprovar",4],[33,4,"régua de TRAÇO",6],[34,4,2.0,7],[34,8,"muda como ela anda, e só ela",9],[35,4,3.0,7],[35,8,"muda o que ela comunica",9],[36,4,5.0,7],[36,8,"muda o que ela percebe",9],[37,4,7.0,7],[37,8,"muda que espaço ela ocupa, a um passo de mexer no tabuleiro",9],[38,4,8.0,7],[38,8,"encosta em outra criatura ou no ambiente: carrega, prende, empurra, barra, alcança além do alcance, aparece onde não dava",9],[40,4,"régua de COMANDO",6],[41,4,0.0,7],[41,8,"é o ataque",9],[42,4,4.0,7],[42,8,"faz uma coisa com um alvo ou um objeto",9],[43,4,8.0,7],[43,8,"protege você, ou nega a ação de outro",9],[45,4,"O QUE O ORÇAMENTO NÃO COMPRA",11],[46,4,"dado de dano",8],[46,18,"o teto de uma Rotina já governa a saída. Um Traço que dê +1d6 não existe",4],[47,4,"qualquer coisa que cresça com refino",8],[47,18,"refino cresce muito mais rápido que a ficha dela, e ela passaria de você",4],[48,4,"atributo",8],[48,18,"os cinco já saem do arranjo dela, e comprar de novo é pagar duas vezes",4],[49,4,"Defesa, acerto ou vida direto",8],[49,18,"os três saem dos atributos dela",4]],"estilos":[["Roboto",12.0,"#F4F1F7",false,"left","middle",0],["Oswald",16.0,"#E8DCD4",false,"left","center",0],["Courier New",8.0,"#998BA9",false,"right"