      [32,66,"Restrição Própria",1],[32,67,2,2],[32,68,0,2],[32,69,"",1],[32,82,"Campo",1],[32,83,"Lapidação 1",1],[32,84,1,2],[32,85,"—",1],[32,86,"Uma vez por cena, você pode realizar Estudar como Ação Bônus, em vez de Ação Padrão. Use a ação descrita em Ações — Estudar, com seus alvos, testes e informações disponíveis.",1],[32,88,1,2],[32,89,0,2],[32,90,0,2],[32,91,"Uma vez por cena, você pode realizar Estudar como Ação Bônus, em vez de Ação Padrão. Use a ação descrita em Ações — Estudar, com seus alvos, testes e informações disponíveis.",1],[32,129,"Feitiço 31",1],[32,130,0,2],[32,131,31,2],[32,132,"=MAX(1,MIN(7,N('FICHA AMALDIÇOADA'!$D$278)))",2],[32,133,"='FICHA AMALDIÇOADA'!$E$278&\"\"",2],[32,134,"='FICHA AMALDIÇOADA'!$E$283&\"\"",2],[32,135,"='FICHA AMALDIÇOADA'!$E$287&\"\"",2],[32,136,"='FICHA AMALDIÇOADA'!$E$288&\"\"",2],[32,137,"='FICHA AMALDIÇOADA'!$E$289&\"\"",2],[32,138,"='FICHA AMALDIÇOADA'!$E$290&\"\"",2],[32,139,"='FICHA AMALDIÇOADA'!$E$291&\"\"",2],[32,140,"='FICHA AMALDIÇOADA'!$E$292&\"\"",2],[32,217,"='FICHA AMALDIÇOADA'!$D$280&\"\"",2],[32,220,"famílias fechadas",1],[32,221,"=COUNTIF('DADOS_CRIACAO'!$I$2:$I$20,\"Fechada\")",2],[32,268,31,2],[32,269,"=IFERROR(MATCH(31,$HJ$2:$HJ$37,0),0)",2],[32,307,"P59",1],[32,308,"=DADOS_AM!$HM$10&\" feitiços grátis · \"&DADOS_AM!$HM$11&\"d8 cada\"",2],[33,55,"Firmeza · perícia",1],[33,56,"Auxiliares",1],[33,57,1,2],[33,60,0,2],[33,63,0,2],[33,82,"Assombro",1],[33,83,"Lapidação 1 e Essência 4",1],[33,84,1,2],[33,85,"—",1],[33,86,"Uma vez por cena, ao entrar nela ou ser visto pela primeira vez, escolha até metade de sua Lapidação, arredondada para baixo, mínimo 1, entre as criaturas presentes que enxerguem você. Cada uma faz TR de Espírito contra CD 8 + sua Essência + sua maestria. Na falha, fica Amedrontada até o fim do próximo turno dela. A presença do personagem provoca o efeito, sem exigir arma ou ferramenta em uso. Essência entra uma única vez na CD. O requisito de acesso não acrescenta um segundo bônus.",1],
      [33,88,1,2],[33,89,0,2],[33,90,0,2],[33,91,"Uma vez por cena, ao entrar nela ou ser visto pela primeira vez, escolha até metade de sua Lapidação, arredondada para baixo, mínimo 1, entre as criaturas presentes que enxerguem você.",1],[33,129,"Feitiço 32",1],[33,130,0,2],[33,131,32,2],[33,132,"=MAX(1,MIN(7,N('FICHA AMALDIÇOADA'!$J$278)))",2],[33,133,"='FICHA AMALDIÇOADA'!$K$278&\"\"",2],[33,134,"='FICHA AMALDIÇOADA'!$K$283&\"\"",2],[33,135,"='FICHA AMALDIÇOADA'!$K$287&\"\"",2],[33,136,"='FICHA AMALDIÇOADA'!$K$288&\"\"",2],[33,137,"='FICHA AMALDIÇOADA'!$K$289&\"\"",2],[33,138,"='FICHA AMALDIÇOADA'!$K$290&\"\"",2],[33,139,"='FICHA AMALDIÇOADA'!$K$291&\"\"",2],[33,140,"='FICHA AMALDIÇOADA'!$K$292&\"\"",2],[33,217,"='FICHA AMALDIÇOADA'!$J$280&\"\"",2],[33,220,"metade do refino",1],[33,221,"=MAX(1,FLOOR($HM$6/2,1))",2],[33,268,32,2],[33,269,"=IFERROR(MATCH(32,$HJ$2:$HJ$37,0),0)",2],[33,307,"D61",1],[33,308,"=UPPER(INDEX(DADOS_AM!$D$3:$G$3,1,DADOS_AM!$A$2))",2],[34,55,"Firmeza · ofício",1],[34,56,"Auxiliares",1],[34,57,1,2],[34,60,0,2],[34,63,0,2],[34,82,"Bênção Própria (CE 1)",1],[34,83,"Uma por personagem",1],[34,84,1,2],[34,85,"—",1],
      [34,86,"Você pode desenvolver uma Bênção Própria por personagem, de Categoria de Efeito 1 ou 2. Crie-a com o mestre antes da sessão e adquira-a por uma escolha de Bênção, respeitando a Lapidação mínima da Categoria de Efeito. Escreva primeiro uma frase que diga o que o corpo consegue fazer. Depois, registre gatilho, alcance, duração e limites necessários. A mesa deve conseguir decidir quando o efeito aconteceu sem discutir novamente a proposta a cada uso. A Bênção segue a orientação de Aptidões e Refino — Aptidão Própria. Ela não acrescenta dados de dano. Se for Categoria de Efeito 2, precisa de um limite por cena. Não pode copiar uma Bênção existente ou fornecer uma capacidade cujo requisito você não alcançou. Uma proposta com requisito de Força ou Constituição deve conceder um feito corporal específico, ligado à sobrevivência, à recuperação ou a outra capacidade física. Bônus, vantagem ou repetição de uma perícia não bastam para representar esse feito. Efeitos de Categoria de Efeito 3 ficam fora desta opção. Se a mesa não conseguir limitar a proposta à Categoria de Efeito 1 ou 2, reduza seu alcance ou escolha outra ideia. Escreva a sua na caixa de baixo.",1],
